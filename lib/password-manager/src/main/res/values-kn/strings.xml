<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Title of the dialog shown before saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__save_to_password_manager">ಪಾಸ್‌ವರ್ಡ್ ಮ್ಯಾನೇಜರ್‌ಗೆ ಸೇವ್ ಮಾಡಬೇಕೇ?</string>
    <!-- Body of the dialog shown before saving to the password manager when Google Password Manager is the device default. Followed by a "Learn more" link. -->
    <string name="SaveToPasswordManagerDialog__google_body">ನೀವು Google ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಪಾಸ್‌ವರ್ಡ್ ಮ್ಯಾನೇಜರ್ ಆಗಿ ಸೆಟ್ ಮಾಡಿದ್ದೀರಿ. ಮುಂದುವರಿಯುವ ಮೊದಲು, Google ಪಾಸ್‌ವರ್ಡ್ ಮ್ಯಾನೇಜರ್‌ನ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಸಾಧನದಲ್ಲಿನ ಎನ್‌ಕ್ರಿಪ್ಶನ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ.</string>
    <!-- Link at the end of the Google Password Manager dialog body that opens a support article -->
    <string name="SaveToPasswordManagerDialog__learn_more">ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ</string>
    <!-- Dialog button that opens Google Password Manager so the user can enable on-device encryption -->
    <string name="SaveToPasswordManagerDialog__open_google_password_manager">Google ಪಾಸ್‌ವರ್ಡ್ ಮ್ಯಾನೇಜರ್ ಅನ್ನು ತೆರೆಯಿರಿ</string>
    <!-- Dialog button that saves to Google Password Manager without first checking its encryption settings -->
    <string name="SaveToPasswordManagerDialog__continue_anyway">ಹೇಗಾದರೂ ಮುಂದುವರಿಯಿರಿ</string>
    <!-- Dialog button that continues saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__continue">ಮುಂದುವರಿಸಿ</string>
</resources>
