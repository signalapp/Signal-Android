<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Title of the dialog shown before saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__save_to_password_manager">Uložit do správce hesel?</string>
    <!-- Body of the dialog shown before saving to the password manager when Google Password Manager is the device default. Followed by a "Learn more" link. -->
    <string name="SaveToPasswordManagerDialog__google_body">Vaším výchozím správcem hesel je Google. Než budete pokračovat, povolte v nastavení správce hesel Google šifrování v zařízení.</string>
    <!-- Link at the end of the Google Password Manager dialog body that opens a support article -->
    <string name="SaveToPasswordManagerDialog__learn_more">Zjistit více</string>
    <!-- Dialog button that opens Google Password Manager so the user can enable on-device encryption -->
    <string name="SaveToPasswordManagerDialog__open_google_password_manager">Otevřete správce hesel Google</string>
    <!-- Dialog button that saves to Google Password Manager without first checking its encryption settings -->
    <string name="SaveToPasswordManagerDialog__continue_anyway">Přesto pokračovat</string>
    <!-- Dialog button that continues saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__continue">Pokračovat</string>
</resources>
