<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Title of the dialog shown before saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__save_to_password_manager">บันทึกไปยังตัวจัดการรหัสผ่านใช่หรือไม่</string>
    <!-- Body of the dialog shown before saving to the password manager when Google Password Manager is the device default. Followed by a "Learn more" link. -->
    <string name="SaveToPasswordManagerDialog__google_body">คุณตั้ง Google ไว้เป็นตัวจัดการรหัสผ่านเริ่มต้น ก่อนดำเนินการต่อ โปรดเปิดใช้งานการเข้ารหัสในอุปกรณ์ โดยไปที่การตั้งค่าของเครื่องมือจัดการรหัสผ่านของ Google</string>
    <!-- Link at the end of the Google Password Manager dialog body that opens a support article -->
    <string name="SaveToPasswordManagerDialog__learn_more">เรียนรู้เพิ่มเติม</string>
    <!-- Dialog button that opens Google Password Manager so the user can enable on-device encryption -->
    <string name="SaveToPasswordManagerDialog__open_google_password_manager">เปิดเครื่องมือจัดการรหัสผ่านของ Google</string>
    <!-- Dialog button that saves to Google Password Manager without first checking its encryption settings -->
    <string name="SaveToPasswordManagerDialog__continue_anyway">ยืนยันที่จะดำเนินการต่อ</string>
    <!-- Dialog button that continues saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__continue">ทำต่อ</string>
</resources>
