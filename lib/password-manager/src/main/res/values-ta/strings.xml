<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Title of the dialog shown before saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__save_to_password_manager">கடவுச்சொல் மேலாளரில் சேமிக்கவா?</string>
    <!-- Body of the dialog shown before saving to the password manager when Google Password Manager is the device default. Followed by a "Learn more" link. -->
    <string name="SaveToPasswordManagerDialog__google_body">உங்களின் இயல்புநிலைக் கடவுச்சொல் மேலாளராக Google-ஐ அமைத்துள்ளீர்கள். தொடர்வதற்கு முன், Google Password Manager-இன் அமைப்புகளில் சாதனத்திலான குறியாக்கத்தைச் செயல்படுத்தவும்.</string>
    <!-- Link at the end of the Google Password Manager dialog body that opens a support article -->
    <string name="SaveToPasswordManagerDialog__learn_more">மேலும் அறிக</string>
    <!-- Dialog button that opens Google Password Manager so the user can enable on-device encryption -->
    <string name="SaveToPasswordManagerDialog__open_google_password_manager">Google Password Manager-ஐத் திற</string>
    <!-- Dialog button that saves to Google Password Manager without first checking its encryption settings -->
    <string name="SaveToPasswordManagerDialog__continue_anyway">எப்படியிருந்தாலும் தொடருங்கள்</string>
    <!-- Dialog button that continues saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__continue">தொடர்</string>
</resources>
