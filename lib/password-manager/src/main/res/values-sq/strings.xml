<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Title of the dialog shown before saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__save_to_password_manager">Të ruhet te menaxheri i fjalëkalimeve?</string>
    <!-- Body of the dialog shown before saving to the password manager when Google Password Manager is the device default. Followed by a "Learn more" link. -->
    <string name="SaveToPasswordManagerDialog__google_body">Ke caktuar Google si menaxherin e parazgjedhur të fjalëkalimeve. Përpara se të vazhdosh, aktivizo kodimin në pajisje te parametrat e menaxherit të fjalëkalimeve të Google.</string>
    <!-- Link at the end of the Google Password Manager dialog body that opens a support article -->
    <string name="SaveToPasswordManagerDialog__learn_more">Mëso më shumë</string>
    <!-- Dialog button that opens Google Password Manager so the user can enable on-device encryption -->
    <string name="SaveToPasswordManagerDialog__open_google_password_manager">Hap menaxherin e fjalëkalimeve të Google</string>
    <!-- Dialog button that saves to Google Password Manager without first checking its encryption settings -->
    <string name="SaveToPasswordManagerDialog__continue_anyway">Vazhdo gjithsesi</string>
    <!-- Dialog button that continues saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__continue">Vazhdo</string>
</resources>
