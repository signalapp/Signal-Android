<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Title of the dialog shown before saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__save_to_password_manager">រក្សាទុកក្នុងកម្មវិធីគ្រប់គ្រងពាក្យសម្ងាត់ឬ?</string>
    <!-- Body of the dialog shown before saving to the password manager when Google Password Manager is the device default. Followed by a "Learn more" link. -->
    <string name="SaveToPasswordManagerDialog__google_body">អ្នកបានកំណត់ Google ជាកម្មវិធីគ្រប់គ្រងពាក្យសម្ងាត់លំនាំដើមរបស់អ្នក។ មុននឹងបន្ត សូមបើកមុខងារអ៊ីនគ្រីបនៅលើឧបករណ៍នៅក្នុងការកំណត់របស់កម្មវិធីគ្រប់គ្រងពាក្យសម្ងាត់ Google។</string>
    <!-- Link at the end of the Google Password Manager dialog body that opens a support article -->
    <string name="SaveToPasswordManagerDialog__learn_more">ស្វែងយល់បន្ថែម</string>
    <!-- Dialog button that opens Google Password Manager so the user can enable on-device encryption -->
    <string name="SaveToPasswordManagerDialog__open_google_password_manager">បើកកម្មវិធីគ្រប់គ្រងពាក្យសម្ងាត់ Google</string>
    <!-- Dialog button that saves to Google Password Manager without first checking its encryption settings -->
    <string name="SaveToPasswordManagerDialog__continue_anyway">បន្តចុះ</string>
    <!-- Dialog button that continues saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__continue">បន្ត</string>
</resources>
