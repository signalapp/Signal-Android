<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Title of the dialog shown before saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__save_to_password_manager">Enregistrer dans le gestionnaire de mots de passe ?</string>
    <!-- Body of the dialog shown before saving to the password manager when Google Password Manager is the device default. Followed by a "Learn more" link. -->
    <string name="SaveToPasswordManagerDialog__google_body">Le Gestionnaire de mots de passe de Google est défini par défaut sur votre appareil. Avant de continuer, accédez aux paramètres du Gestionnaire de mots de passe de Google et activez le chiffrement sur l\'appareil.</string>
    <!-- Link at the end of the Google Password Manager dialog body that opens a support article -->
    <string name="SaveToPasswordManagerDialog__learn_more">En savoir plus</string>
    <!-- Dialog button that opens Google Password Manager so the user can enable on-device encryption -->
    <string name="SaveToPasswordManagerDialog__open_google_password_manager">Ouvrir le Gestionnaire de mots de passe de Google</string>
    <!-- Dialog button that saves to Google Password Manager without first checking its encryption settings -->
    <string name="SaveToPasswordManagerDialog__continue_anyway">Continuer quand même</string>
    <!-- Dialog button that continues saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__continue">Continuer</string>
</resources>
