    <string name="SaveToPasswordManagerDialog__open_google_password_manager">Άνοιγμα του Google Password Manager</string>
    <!-- Dialog button that saves to Google Password Manager without first checking its encryption settings -->
    <string name="SaveToPasswordManagerDialog__continue_anyway">Συνέχεια παρ\' όλα αυτά</string>
