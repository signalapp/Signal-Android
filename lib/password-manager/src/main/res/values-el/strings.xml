    <!-- Body of the dialog shown before saving to the password manager when Google Password Manager is the device default. Followed by a "Learn more" link. -->
    <string name="SaveToPasswordManagerDialog__google_body">Έχεις ορίσει το Google ως τον προεπιλεγμένο διαχειριστή κωδικών πρόσβασης Πριν συνεχίσεις, ενεργοποίησε την κρυπτογράφηση στη συσκευή στις ρυθμίσεις του Google Password Manager.</string>
    <!-- Link at the end of the Google Password Manager dialog body that opens a support article -->
    <string name="SaveToPasswordManagerDialog__learn_more">Μάθε περισσότερα</string>
