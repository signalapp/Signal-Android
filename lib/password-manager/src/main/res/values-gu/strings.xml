<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Title of the dialog shown before saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__save_to_password_manager">પાસવર્ડ મેનેજરમાં સેવ કરવું છે?</string>
    <!-- Body of the dialog shown before saving to the password manager when Google Password Manager is the device default. Followed by a "Learn more" link. -->
    <string name="SaveToPasswordManagerDialog__google_body">તમે Googleને તમારા ડિફોલ્ટ પાસવર્ડ મેનેજર તરીકે સેટ કર્યું છે. આગળ વધતા પહેલાં, Google પાસવર્ડ મેનેજરના સેટિંગ્સમાં \'ઓન-ડિવાઇસ એન્ક્રિપ્શન\' સક્ષમ કરો.</string>
    <!-- Link at the end of the Google Password Manager dialog body that opens a support article -->
    <string name="SaveToPasswordManagerDialog__learn_more">વધુ જાણો</string>
    <!-- Dialog button that opens Google Password Manager so the user can enable on-device encryption -->
    <string name="SaveToPasswordManagerDialog__open_google_password_manager">Google પાસવર્ડ મેનેજર ખોલો</string>
    <!-- Dialog button that saves to Google Password Manager without first checking its encryption settings -->
    <string name="SaveToPasswordManagerDialog__continue_anyway">કોઈ પણ રીતે ચાલુ રાખો</string>
    <!-- Dialog button that continues saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__continue">ચાલુ રાખો</string>
</resources>
