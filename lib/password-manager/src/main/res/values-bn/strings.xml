<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Title of the dialog shown before saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__save_to_password_manager">পাসওয়ার্ড ম্যানেজারে সেভ করবেন?</string>
    <!-- Body of the dialog shown before saving to the password manager when Google Password Manager is the device default. Followed by a "Learn more" link. -->
    <string name="SaveToPasswordManagerDialog__google_body">আপনার ডিফল্ট পাসওয়ার্ড ম্যানেজার হিসেবে Google নির্ধারণ করা আছে। এগিয়ে যাওয়ার আগে, Google পাসওয়ার্ড ম্যানেজারের সেটিংস থেকে \'অন-ডিভাইস এনক্রিপশন\' চালু করুন।</string>
    <!-- Link at the end of the Google Password Manager dialog body that opens a support article -->
    <string name="SaveToPasswordManagerDialog__learn_more">আরো জানুন</string>
    <!-- Dialog button that opens Google Password Manager so the user can enable on-device encryption -->
    <string name="SaveToPasswordManagerDialog__open_google_password_manager">Google পাসওয়ার্ড ম্যানেজার খুলুন</string>
    <!-- Dialog button that saves to Google Password Manager without first checking its encryption settings -->
    <string name="SaveToPasswordManagerDialog__continue_anyway">যেভাবেই হোক এগিয়ে যান</string>
    <!-- Dialog button that continues saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__continue">চলতে থাকুন</string>
</resources>
