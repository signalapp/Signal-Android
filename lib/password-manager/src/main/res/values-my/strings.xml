<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Title of the dialog shown before saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__save_to_password_manager">စကားဝှက်စီမံရေးတွင် သိမ်းဆည်းမလား။</string>
    <!-- Body of the dialog shown before saving to the password manager when Google Password Manager is the device default. Followed by a "Learn more" link. -->
    <string name="SaveToPasswordManagerDialog__google_body">သင်သည် Google ကို မူလစကားဝှက်စီမံရေးအဖြစ် သတ်မှတ်ထားပါသည်။ ဆက်လက်မလုပ်ဆောင်မီ Google စကားဝှက်စီမံခန့်ခွဲရေး၏ ဆက်တင်များတွင် စက်အတွင်း ကုဒ်ပြောင်းဝှက်ခြင်းကို ဖွင့်ပါ။</string>
    <!-- Link at the end of the Google Password Manager dialog body that opens a support article -->
    <string name="SaveToPasswordManagerDialog__learn_more">ပိုမိုလေ့လာရန်</string>
    <!-- Dialog button that opens Google Password Manager so the user can enable on-device encryption -->
    <string name="SaveToPasswordManagerDialog__open_google_password_manager">Google စကားဝှက် စီမံခန့်ခွဲရေးကို ဖွင့်ပါ</string>
    <!-- Dialog button that saves to Google Password Manager without first checking its encryption settings -->
    <string name="SaveToPasswordManagerDialog__continue_anyway">မည်သို့ပင်ဖြစ်စေ ဆက်လုပ်ရန်</string>
    <!-- Dialog button that continues saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__continue">ဆက်လုပ်ရန်</string>
</resources>
