<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Title of the dialog shown before saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__save_to_password_manager">పాస్‌వర్డ్ మేనేజర్‌లో సేవ్ చేయాలా?</string>
    <!-- Body of the dialog shown before saving to the password manager when Google Password Manager is the device default. Followed by a "Learn more" link. -->
    <string name="SaveToPasswordManagerDialog__google_body">మీరు గూగుల్ ను మీ డిఫాల్ట్ పాస్‌వర్డ్ మేనేజర్‌గా సెట్ చేశారు. కొనసాగించేముందు, గూగుల్ పాస్‌వర్డ్ మేనేజర్ సెట్టింగ్లలో పరికరం గుప్తీకరణను ప్రారంభించండి.</string>
    <!-- Link at the end of the Google Password Manager dialog body that opens a support article -->
    <string name="SaveToPasswordManagerDialog__learn_more">మరింత తెలుసుకోండి</string>
    <!-- Dialog button that opens Google Password Manager so the user can enable on-device encryption -->
    <string name="SaveToPasswordManagerDialog__open_google_password_manager">గూగుల్ పాస్‌వర్డ్ మేనేజర్ ను తెరవండి</string>
    <!-- Dialog button that saves to Google Password Manager without first checking its encryption settings -->
    <string name="SaveToPasswordManagerDialog__continue_anyway">ఏమైనాగాని కొనసాగండి</string>
    <!-- Dialog button that continues saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__continue">కొనసాగించు</string>
</resources>
