<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Title of the dialog shown before saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__save_to_password_manager">पासवर्ड मैनेजर में सेव करना है?</string>
    <!-- Body of the dialog shown before saving to the password manager when Google Password Manager is the device default. Followed by a "Learn more" link. -->
    <string name="SaveToPasswordManagerDialog__google_body">आपने Google को अपना डिफ़ॉल्ट पासवर्ड मैनेजर सेट किया हुआ है। आगे बढ़ने से पहले, Google Password Manager की सेटिंग में जाकर ऑन-डिवाइस एनक्रिप्शन चालू करें।</string>
    <!-- Link at the end of the Google Password Manager dialog body that opens a support article -->
    <string name="SaveToPasswordManagerDialog__learn_more">और जानें</string>
    <!-- Dialog button that opens Google Password Manager so the user can enable on-device encryption -->
    <string name="SaveToPasswordManagerDialog__open_google_password_manager">Google Password Manager खोलें</string>
    <!-- Dialog button that saves to Google Password Manager without first checking its encryption settings -->
    <string name="SaveToPasswordManagerDialog__continue_anyway">फिर भी जारी रखें</string>
    <!-- Dialog button that continues saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__continue">जारी रखें</string>
</resources>
