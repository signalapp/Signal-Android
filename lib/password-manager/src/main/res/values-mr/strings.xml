<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Title of the dialog shown before saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__save_to_password_manager">पासवर्ड व्यवस्थापकामध्ये जतन करायची?</string>
    <!-- Body of the dialog shown before saving to the password manager when Google Password Manager is the device default. Followed by a "Learn more" link. -->
    <string name="SaveToPasswordManagerDialog__google_body">Google हा तुमचा डीफॉल्ट पासवर्ड व्यवस्थापक म्हणून सेट करा. पुढे सुरु ठेवण्यापूर्वी, Google पासवर्ड व्यवस्थापक सेटिंग्जमध्ये डिव्हाईसवरील एन्क्रिप्शन चालू करा.</string>
    <!-- Link at the end of the Google Password Manager dialog body that opens a support article -->
    <string name="SaveToPasswordManagerDialog__learn_more">अधिक जाणून घ्या</string>
    <!-- Dialog button that opens Google Password Manager so the user can enable on-device encryption -->
    <string name="SaveToPasswordManagerDialog__open_google_password_manager">Google पासवर्ड व्यवस्थापक उघडा</string>
    <!-- Dialog button that saves to Google Password Manager without first checking its encryption settings -->
    <string name="SaveToPasswordManagerDialog__continue_anyway">तरीही सुरू ठेवा</string>
    <!-- Dialog button that continues saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__continue">सुरू ठेवा</string>
</resources>
