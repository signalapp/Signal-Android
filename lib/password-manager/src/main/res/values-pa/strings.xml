<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Title of the dialog shown before saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__save_to_password_manager">ਕੀ ਪਾਸਵਰਡ ਮੈਨੇਜਰ ਵਿੱਚ ਸੇਵ ਕਰਨਾ ਹੈ?</string>
    <!-- Body of the dialog shown before saving to the password manager when Google Password Manager is the device default. Followed by a "Learn more" link. -->
    <string name="SaveToPasswordManagerDialog__google_body">ਤੁਸੀਂ Google ਨੂੰ ਆਪਣੇ ਡਿਫੌਲਟ ਪਾਸਵਰਡ ਮੈਨੇਜਰ ਵਜੋਂ ਸੈੱਟ ਕੀਤਾ ਹੋਇਆ ਹੈ। ਜਾਰੀ ਰੱਖਣ ਤੋਂ ਪਹਿਲਾਂ, Google ਪਾਸਵਰਡ ਮੈਨੇਜਰ ਦੀਆਂ ਸੈਟਿੰਗਾਂ ਵਿੱਚ \'ਡਿਵਾਈਸ ਉੱਤੇ ਇਨਕ੍ਰਿਪਸ਼ਨ\' ਨੂੰ ਚਾਲੂ ਕਰੋ।</string>
    <!-- Link at the end of the Google Password Manager dialog body that opens a support article -->
    <string name="SaveToPasswordManagerDialog__learn_more">ਹੋਰ ਜਾਣੋ</string>
    <!-- Dialog button that opens Google Password Manager so the user can enable on-device encryption -->
    <string name="SaveToPasswordManagerDialog__open_google_password_manager">Google ਪਾਸਵਰਡ ਮੈਨੇਜਰ ਨੂੰ ਖੋਲ੍ਹੋ</string>
    <!-- Dialog button that saves to Google Password Manager without first checking its encryption settings -->
    <string name="SaveToPasswordManagerDialog__continue_anyway">ਫਿਰ ਵੀ ਜਾਰੀ ਰੱਖੋ</string>
    <!-- Dialog button that continues saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__continue">ਜਾਰੀ ਰੱਖੋ</string>
</resources>
