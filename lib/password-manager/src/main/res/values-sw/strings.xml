<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Title of the dialog shown before saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__save_to_password_manager">Ungependa kuhifadhi kwenye kidhibiti cha manenosiri?</string>
    <!-- Body of the dialog shown before saving to the password manager when Google Password Manager is the device default. Followed by a "Learn more" link. -->
    <string name="SaveToPasswordManagerDialog__google_body">Umeweka Google kama kidhibiti chaguomsingi cha manenosiri yako. Kabla hujaendelea, washa usimbaji fiche wa ndani ya kifaa katika mipangilio ya Kidhibiti Manenosiri cha Google.</string>
    <!-- Link at the end of the Google Password Manager dialog body that opens a support article -->
    <string name="SaveToPasswordManagerDialog__learn_more">Jifunze zaidi</string>
    <!-- Dialog button that opens Google Password Manager so the user can enable on-device encryption -->
    <string name="SaveToPasswordManagerDialog__open_google_password_manager">Fungua Kidhibiti Manenosiri cha Google</string>
    <!-- Dialog button that saves to Google Password Manager without first checking its encryption settings -->
    <string name="SaveToPasswordManagerDialog__continue_anyway">Endelea hata hivyo</string>
    <!-- Dialog button that continues saving to the password manager -->
    <string name="SaveToPasswordManagerDialog__continue">Endelea</string>
</resources>
