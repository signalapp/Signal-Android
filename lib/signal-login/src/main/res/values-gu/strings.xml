<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Signal Login beta labeling -->
    <!-- Tag shown beside the title of Signal Login screens, marking the feature as unfinished. Keep it short. -->
    <string name="SignalLoginBeta__beta">બીટા</string>
    <!-- Disclaimer shown on Signal Login screens, warning that the feature is still changing. -->
    <string name="SignalLoginBeta__this_is_a_beta_feature_that_will_be_updated">આ એક બીટા સુવિધા છે જેને સતત ધોરણે અપડેટ કરવામાં આવશે.</string>

    <!-- Signal Login credential card -->
    <!-- Label for the account portion of the Signal Login on the credential card. -->
    <string name="SignalLoginCard__account">એકાઉન્ટ</string>
    <!-- Label for the recovery portion of the Signal Login on the credential card. -->
    <string name="SignalLoginCard__recovery">રિકવરી</string>
    <!-- Button on the credential card that reveals the full Signal Login. -->
    <string name="SignalLoginCard__view_details">વિગતો જુઓ</string>

    <!-- Signal Login view details screen -->
    <!-- Title of the screen that shows the user the full keys that make up their Signal Login. -->
    <string name="SignalLoginViewDetailsScreen__signal_login">Signal Login</string>
    <!-- Content description for the back arrow in the top app bar. -->
    <string name="SignalLoginViewDetailsScreen__navigate_back">પાછા જાઓ</string>
    <!-- Section header above the account key. -->
    <string name="SignalLoginKeyDetails__account_id">એકાઉન્ટ ID</string>
    <!-- Section header above the recovery key. -->
    <string name="SignalLoginKeyDetails__recovery_key">રિકવરી કી</string>
    <!-- Content description for the button that copies the account key to the clipboard. -->
    <string name="SignalLoginKeyDetails__copy_account_id">એકાઉન્ટ ID કૉપિ કરો</string>
    <!-- Content description for the button that copies the recovery key to the clipboard. -->
    <string name="SignalLoginKeyDetails__copy_recovery_key">રિકવરી કી કૉપિ કરો</string>
    <!-- Action button that stores the Signal Login in the device password manager. -->
    <string name="SignalLoginViewDetailsScreen__save_to_password_manager">પાસવર્ડ મેનેજરમાં સેવ કરો</string>
    <!-- Action button that saves the Signal Login as a PDF. -->
    <string name="SignalLoginViewDetailsScreen__save_as_pdf">PDF તરીક સેવ કરો</string>
    <!-- Action button that starts the flow to replace the recovery key with a newly-generated one. -->
    <string name="SignalLoginViewDetailsScreen__reset_recovery_key">રિકવરી કી ફરીથી સેટ કરો</string>
    <!-- Suggested file name prefilled in the system save dialog when saving the Signal Login as a PDF. Keep the .pdf extension. -->
    <string name="SignalLoginViewDetailsScreen__signal_login_pdf">Signal Login.pdf</string>
    <!-- Toast shown when the user taps the disabled save to password manager button and the device has no password manager. -->
    <string name="SignalLoginViewDetailsScreen__no_password_manager_available">તમારી પાસે કોઈ પાસવર્ડ મેનેજર સેટ કરેલ નથી અથવા તમે જે પાસવર્ડ મેનેજરનો ઉપયોગ કરી રહ્યા છો તે સપોર્ટેડ નથી.</string>
    <!-- Toast shown when saving the Signal Login PDF fails. -->
    <string name="SignalLoginViewDetailsScreen__unable_to_save_pdf">PDF સેવ કરવામાં અસમર્થ. કૃપા કરીને ફરીથી પ્રયાસ કરો.</string>
    <!-- Toast shown when the location the user picked for the Signal Login PDF refuses the write. -->
    <string name="SignalLoginViewDetailsScreen__cant_save_pdf_to_the_selected_location">PDFને પસંદ કરેલ લોકેશન પર સેવ કરી ન શક્યા.</string>

    <!-- Signal Login PDF -->
    <!-- Title at the top of the PDF that holds the user\'s Signal Login. -->
    <string name="SignalLoginPdf__your_signal_login">તમારું Signal Login</string>
    <!-- Explainer below the title of the PDF that holds the user\'s Signal Login. -->
    <string name="SignalLoginPdf__store_this_in_a_safe_place">આને સુરક્ષિત જગ્યાએ સ્ટોર કરો, તમારા એકાઉન્ટ અને ડેટાને રિકવર કરવા માટે તમારી લૉગ ઇન માહિતી જરૂરી છે. તેને કોઈની પણ સાથે શેર કરશો નહીં.</string>
    <!-- Section header above the account key in the PDF. -->
    <string name="SignalLoginPdf__account_id">એકાઉન્ટ ID</string>
    <!-- Section header above the recovery key in the PDF. -->
    <string name="SignalLoginPdf__recovery_key">રિકવરી કી</string>
</resources>
