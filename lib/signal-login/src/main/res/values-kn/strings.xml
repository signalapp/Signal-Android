<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Signal Login beta labeling -->
    <!-- Tag shown beside the title of Signal Login screens, marking the feature as unfinished. Keep it short. -->
    <string name="SignalLoginBeta__beta">ಬೀಟಾ</string>
    <!-- Disclaimer shown on Signal Login screens, warning that the feature is still changing. -->
    <string name="SignalLoginBeta__this_is_a_beta_feature_that_will_be_updated">ಇದು ಬೀಟಾ ಫೀಚರ್ ಆಗಿದ್ದು, ಅದನ್ನು ನಿರಂತರವಾಗಿ ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತದೆ.</string>

    <!-- Signal Login credential card -->
    <!-- Label for the account portion of the Signal Login on the credential card. -->
    <string name="SignalLoginCard__account">ಖಾತೆ</string>
    <!-- Label for the recovery portion of the Signal Login on the credential card. -->
    <string name="SignalLoginCard__recovery">ರಿಕವರಿ</string>
    <!-- Button on the credential card that reveals the full Signal Login. -->
    <string name="SignalLoginCard__view_details">ವಿವರಗಳನ್ನು ವೀಕ್ಷಿಸಿ</string>

    <!-- Signal Login view details screen -->
    <!-- Title of the screen that shows the user the full keys that make up their Signal Login. -->
    <string name="SignalLoginViewDetailsScreen__signal_login">Signal Login</string>
    <!-- Content description for the back arrow in the top app bar. -->
    <string name="SignalLoginViewDetailsScreen__navigate_back">ಹಿಂದಕ್ಕೆ ನ್ಯಾವಿಗೇಟ್ ಮಾಡಿ</string>
    <!-- Section header above the account key. -->
    <string name="SignalLoginKeyDetails__account_id">ಖಾತೆ ID</string>
    <!-- Section header above the recovery key. -->
    <string name="SignalLoginKeyDetails__recovery_key">ರಿಕವರಿ ಕೀ</string>
    <!-- Content description for the button that copies the account key to the clipboard. -->
    <string name="SignalLoginKeyDetails__copy_account_id">ಖಾತೆ ID ಅನ್ನು ಕಾಪಿ ಮಾಡಿ</string>
    <!-- Content description for the button that copies the recovery key to the clipboard. -->
    <string name="SignalLoginKeyDetails__copy_recovery_key">ರಿಕವರಿ ಕೀ ಅನ್ನು ಕಾಪಿ ಮಾಡಿ</string>
    <!-- Action button that stores the Signal Login in the device password manager. -->
    <string name="SignalLoginViewDetailsScreen__save_to_password_manager">ಪಾಸ್‌ವರ್ಡ್ ಮ್ಯಾನೇಜರ್‌ಗೆ ಸೇವ್ ಮಾಡಿ</string>
    <!-- Action button that saves the Signal Login as a PDF. -->
    <string name="SignalLoginViewDetailsScreen__save_as_pdf">PDF ರೂಪದಲ್ಲಿ ಸೇವ್ ಮಾಡಿ</string>
    <!-- Action button that starts the flow to replace the recovery key with a newly-generated one. -->
    <string name="SignalLoginViewDetailsScreen__reset_recovery_key">ರಿಕವರಿ ಕೀ ಮರುಹೊಂದಿಸಿ</string>
    <!-- Suggested file name prefilled in the system save dialog when saving the Signal Login as a PDF. Keep the .pdf extension. -->
    <string name="SignalLoginViewDetailsScreen__signal_login_pdf">Signal Login.pdf</string>
    <!-- Toast shown when the user taps the disabled save to password manager button and the device has no password manager. -->
    <string name="SignalLoginViewDetailsScreen__no_password_manager_available">You don\'t have a password manager set up, or the password manager you\'re using isn\'t supported.</string>
    <!-- Toast shown when saving the Signal Login PDF fails. -->
    <string name="SignalLoginViewDetailsScreen__unable_to_save_pdf">PDF ಸೇವ್ ಮಾಡಲು ಆಗಲಿಲ್ಲ. ಮತ್ತೊಮ್ಮೆ ಪ್ರಯತ್ನಿಸಿ.</string>
    <!-- Toast shown when the location the user picked for the Signal Login PDF refuses the write. -->
    <string name="SignalLoginViewDetailsScreen__cant_save_pdf_to_the_selected_location">ಆಯ್ಕೆಮಾಡಿರುವ ಸ್ಥಳಕ್ಕೆ PDF ಸೇವ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ.</string>

    <!-- Signal Login PDF -->
    <!-- Title at the top of the PDF that holds the user\'s Signal Login. -->
    <string name="SignalLoginPdf__your_signal_login">ನಿಮ್ಮ Signal Login</string>
    <!-- Explainer below the title of the PDF that holds the user\'s Signal Login. -->
    <string name="SignalLoginPdf__store_this_in_a_safe_place">ಇದನ್ನು ಸುರಕ್ಷಿತ ಸ್ಥಳದಲ್ಲಿ ರಕ್ಷಿಸಿ, ನಿಮ್ಮ ಖಾತೆ ಮತ್ತು ಡೇಟಾವನ್ನು ರಿಕವರ್ ಮಾಡಲು ನಿಮ್ಮ ಲಾಗಿನ್ ಮಾಹಿತಿ ಅಗತ್ಯವಿದೆ. ಇದನ್ನು ಎಂದಿಗೂ ಯಾರೊಂದಿಗೂ ಹಂಚಿಕೊಳ್ಳಬೇಡಿ.</string>
    <!-- Section header above the account key in the PDF. -->
    <string name="SignalLoginPdf__account_id">ಖಾತೆ ID</string>
    <!-- Section header above the recovery key in the PDF. -->
    <string name="SignalLoginPdf__recovery_key">ರಿಕವರಿ ಕೀ</string>
</resources>
