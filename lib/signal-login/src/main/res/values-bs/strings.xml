<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Signal Login beta labeling -->
    <!-- Tag shown beside the title of Signal Login screens, marking the feature as unfinished. Keep it short. -->
    <string name="SignalLoginBeta__beta">BETA</string>
    <!-- Disclaimer shown on Signal Login screens, warning that the feature is still changing. -->
    <string name="SignalLoginBeta__this_is_a_beta_feature_that_will_be_updated">Ovo je beta funkcija koja će se kontinuirano ažurirati.</string>

    <!-- Signal Login credential card -->
    <!-- Label for the account portion of the Signal Login on the credential card. -->
    <string name="SignalLoginCard__account">Račun</string>
    <!-- Label for the recovery portion of the Signal Login on the credential card. -->
    <string name="SignalLoginCard__recovery">Oporavak</string>
    <!-- Button on the credential card that reveals the full Signal Login. -->
    <string name="SignalLoginCard__view_details">Prikaži detalje</string>

    <!-- Signal Login view details screen -->
    <!-- Title of the screen that shows the user the full keys that make up their Signal Login. -->
    <string name="SignalLoginViewDetailsScreen__signal_login">Signal prijava</string>
    <!-- Content description for the back arrow in the top app bar. -->
    <string name="SignalLoginViewDetailsScreen__navigate_back">Navigiraj nazad</string>
    <!-- Section header above the account key. -->
    <string name="SignalLoginKeyDetails__account_id">ID računa</string>
    <!-- Section header above the recovery key. -->
    <string name="SignalLoginKeyDetails__recovery_key">Ključ za oporavak</string>
    <!-- Content description for the button that copies the account key to the clipboard. -->
    <string name="SignalLoginKeyDetails__copy_account_id">Kopiraj ID računa</string>
    <!-- Content description for the button that copies the recovery key to the clipboard. -->
    <string name="SignalLoginKeyDetails__copy_recovery_key">Kopiraj ključ za oporavak</string>
    <!-- Action button that stores the Signal Login in the device password manager. -->
    <string name="SignalLoginViewDetailsScreen__save_to_password_manager">Sačuvaj u upravitelju lozinki</string>
    <!-- Action button that saves the Signal Login as a PDF. -->
    <string name="SignalLoginViewDetailsScreen__save_as_pdf">Sačuvaj kao PDF</string>
    <!-- Action button that starts the flow to replace the recovery key with a newly-generated one. -->
    <string name="SignalLoginViewDetailsScreen__reset_recovery_key">Resetiraj ključ za oporavak</string>
    <!-- Suggested file name prefilled in the system save dialog when saving the Signal Login as a PDF. Keep the .pdf extension. -->
    <string name="SignalLoginViewDetailsScreen__signal_login_pdf">Signal Login.pdf</string>
    <!-- Toast shown when the user taps the disabled save to password manager button and the device has no password manager. -->
    <string name="SignalLoginViewDetailsScreen__no_password_manager_available">Nemate postavljen upravitelj lozinki.</string>
    <!-- Body of the dialog asking the user to confirm saving their Signal Login credentials to the device password manager. -->
    <string name="SignalLoginViewDetailsScreen__only_store_your_credentials">Pohranjujte svoje akreditive samo u upravitelju lozinki za koji vjerujete da je siguran. Signal ne daje preporuke o tome koji je upravitelj lozinki pravi za vas.</string>
    <!-- Toast shown when saving the Signal Login PDF fails. -->
    <string name="SignalLoginViewDetailsScreen__unable_to_save_pdf">Nije moguće sačuvati PDF. Molimo pokušajte ponovno.</string>
    <!-- Toast shown when the location the user picked for the Signal Login PDF refuses the write. -->
    <string name="SignalLoginViewDetailsScreen__cant_save_pdf_to_the_selected_location">Nije moguće sačuvati PDF na odabranu lokaciju.</string>

    <!-- Do not share warning sheet, shown before the user copies or saves their Signal Login -->
    <!-- Title of the sheet warning the user not to share their Signal Login. -->
    <string name="DoNotShareLoginBottomSheet__do_not_share_your_signal_login">Ne dijelite Signal Login</string>
    <!-- Body of the warning sheet. The text inside the <b> tags is shown in bold; keep the tags around the equivalent phrase. -->
    <string name="DoNotShareLoginBottomSheet__do_not_share_your_signal_login_with_anyone">Ne dijelite Signal Login ni sa kim. To će omogućiti drugima da preuzmu vaš račun. <b>Signal vam nikada neće poslati poruku</b> u kojoj traži ID računa ili ključ za oporavak. Ne odgovarajte na poruke koje navodno dolaze od Signala.</string>
    <!-- Button acknowledging the warning and continuing with the copy or save the user started. -->
    <string name="DoNotShareLoginBottomSheet__got_it">Razumijem</string>
    <!-- Button opening a help article with more information about keeping the Signal Login safe. -->
    <string name="DoNotShareLoginBottomSheet__learn_more">Saznaj više</string>

    <!-- Signal Login PDF -->
    <!-- Title at the top of the PDF that holds the user\'s Signal Login. -->
    <string name="SignalLoginPdf__your_signal_login">Vaš Signal Login</string>
    <!-- Explainer below the title of the PDF that holds the user\'s Signal Login. -->
    <string name="SignalLoginPdf__store_this_in_a_safe_place">Sačuvajte ovo na sigurnom mjestu, podaci za prijavu su potrebni za oporavak računa i podataka. Nikada ih ne dijelite ni s kim.</string>
    <!-- Section header above the account key in the PDF. -->
    <string name="SignalLoginPdf__account_id">ID računa</string>
    <!-- Section header above the recovery key in the PDF. -->
    <string name="SignalLoginPdf__recovery_key">Ključ za oporavak</string>
</resources>
