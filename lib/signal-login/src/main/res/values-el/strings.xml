<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Signal Login beta labeling -->
    <!-- Tag shown beside the title of Signal Login screens, marking the feature as unfinished. Keep it short. -->
    <string name="SignalLoginBeta__beta">ΒΕΤΑ</string>
    <!-- Disclaimer shown on Signal Login screens, warning that the feature is still changing. -->
    <string name="SignalLoginBeta__this_is_a_beta_feature_that_will_be_updated">Πρόκειται για μια λειτουργία σε φάση Beta, η οποία θα ενημερώνεται συνεχώς.</string>

    <!-- Signal Login credential card -->
    <!-- Label for the account portion of the Signal Login on the credential card. -->
    <string name="SignalLoginCard__account">Λογαριασμός</string>
    <!-- Label for the recovery portion of the Signal Login on the credential card. -->
    <string name="SignalLoginCard__recovery">Ανάκτηση</string>
    <!-- Button on the credential card that reveals the full Signal Login. -->
    <string name="SignalLoginCard__view_details">Προβολή λεπτομερειών</string>

    <!-- Signal Login view details screen -->
    <!-- Title of the screen that shows the user the full keys that make up their Signal Login. -->
    <string name="SignalLoginViewDetailsScreen__signal_login">Signal Login</string>
    <!-- Content description for the back arrow in the top app bar. -->
    <string name="SignalLoginViewDetailsScreen__navigate_back">Περιήγηση προς τα πίσω</string>
    <!-- Section header above the account key. -->
    <string name="SignalLoginKeyDetails__account_id">ID λογαριασμού</string>
    <!-- Section header above the recovery key. -->
    <string name="SignalLoginKeyDetails__recovery_key">Κλειδί ανάκτησης</string>
    <!-- Content description for the button that copies the account key to the clipboard. -->
    <string name="SignalLoginKeyDetails__copy_account_id">Αντιγραφή ID λογαριασμού</string>
    <!-- Content description for the button that copies the recovery key to the clipboard. -->
    <string name="SignalLoginKeyDetails__copy_recovery_key">Αντιγραφή κλειδιού ανάκτησης</string>
    <!-- Action button that stores the Signal Login in the device password manager. -->
    <string name="SignalLoginViewDetailsScreen__save_to_password_manager">Αποθήκευση στον διαχειριστή κωδικών πρόσβασης</string>
    <!-- Action button that saves the Signal Login as a PDF. -->
    <string name="SignalLoginViewDetailsScreen__save_as_pdf">Αποθήκευση ως PDF</string>
    <!-- Action button that starts the flow to replace the recovery key with a newly-generated one. -->
    <string name="SignalLoginViewDetailsScreen__reset_recovery_key">Επαναφορά κλειδιού ανάκτησης</string>
    <!-- Suggested file name prefilled in the system save dialog when saving the Signal Login as a PDF. Keep the .pdf extension. -->
    <string name="SignalLoginViewDetailsScreen__signal_login_pdf">Signal Login.pdf</string>
    <!-- Toast shown when the user taps the disabled save to password manager button and the device has no password manager. -->
    <string name="SignalLoginViewDetailsScreen__no_password_manager_available">Δεν έχεις ρυθμίσει κάποιο πρόγραμμα διαχείρισης κωδικών πρόσβασης.</string>
    <!-- Body of the dialog asking the user to confirm saving their Signal Login credentials to the device password manager. -->
    <string name="SignalLoginViewDetailsScreen__only_store_your_credentials">Αποθήκευσε τα διαπιστευτήριά σου μόνο σε κάποιο διαχειριστή κωδικών πρόσβασης που εμπιστεύεσαι ότι είναι ασφαλής. Το Signal δεν κάνει συστάσεις σχετικά με το ποιος διαχειριστής κωδικών πρόσβασης είναι κατάλληλος για σένα.</string>
    <!-- Toast shown when saving the Signal Login PDF fails. -->
    <string name="SignalLoginViewDetailsScreen__unable_to_save_pdf">Δεν ήταν δυνατή η αποθήκευση του PDF. Δοκίμασε ξανά.</string>
    <!-- Toast shown when the location the user picked for the Signal Login PDF refuses the write. -->
    <string name="SignalLoginViewDetailsScreen__cant_save_pdf_to_the_selected_location">Δεν ήταν δυνατή η αποθήκευση του PDF στην επιλεγμένη τοποθεσία.</string>

    <!-- Do not share warning sheet, shown before the user copies or saves their Signal Login -->
    <!-- Title of the sheet warning the user not to share their Signal Login. -->
    <string name="DoNotShareLoginBottomSheet__do_not_share_your_signal_login">Do not share your Signal Login</string>
    <!-- Body of the warning sheet. The text inside the <b> tags is shown in bold; keep the tags around the equivalent phrase. -->
    <string name="DoNotShareLoginBottomSheet__do_not_share_your_signal_login_with_anyone">Do not share your Signal Login with anyone. This will let them take over your account. <b>Signal will never message you</b> for your account ID or recovery key. Never respond to a chat pretending to be Signal.</string>
    <!-- Button acknowledging the warning and continuing with the copy or save the user started. -->
    <string name="DoNotShareLoginBottomSheet__got_it">Εντάξει</string>
    <!-- Button opening a help article with more information about keeping the Signal Login safe. -->
    <string name="DoNotShareLoginBottomSheet__learn_more">Μάθε περισσότερα</string>

    <!-- Signal Login PDF -->
    <!-- Title at the top of the PDF that holds the user\'s Signal Login. -->
    <string name="SignalLoginPdf__your_signal_login">Το Signal Login σου</string>
    <!-- Explainer below the title of the PDF that holds the user\'s Signal Login. -->
    <string name="SignalLoginPdf__store_this_in_a_safe_place">Αποθήκευσέ το σε ασφαλές μέρος, καθώς θα χρειαστείς τα στοιχεία σύνδεσής σου για να ανακτήσεις τον λογαριασμό και τα δεδομένα σου. Μην το μοιράζεσαι ποτέ με κανέναν.</string>
    <!-- Section header above the account key in the PDF. -->
    <string name="SignalLoginPdf__account_id">ID λογαριασμού</string>
    <!-- Section header above the recovery key in the PDF. -->
    <string name="SignalLoginPdf__recovery_key">Κλειδί ανάκτησης</string>
</resources>
