    <string name="SignalLoginViewDetailsScreen__signal_login">Signal Login</string>
    <!-- Content description for the back arrow in the top app bar. -->
    <string name="SignalLoginViewDetailsScreen__navigate_back">Déan nascleanúint siar</string>
    <!-- Section header above the account key. -->
    <string name="SignalLoginKeyDetails__account_id">ID an chuntais</string>
    <!-- Section header above the recovery key. -->
    <string name="SignalLoginKeyDetails__recovery_key">Eochair athshlánaithe</string>
    <!-- Content description for the button that copies the account key to the clipboard. -->
    <string name="SignalLoginKeyDetails__copy_account_id">Cóipeáil aitheantas an chuntais</string>
