<resources>
    <!-- Permissions -->
    <!-- Button label to confirm and proceed with a permission request -->
    <string name="Permissions_continue">ಮುಂದುವರಿಸಿ</string>
    <!-- Button label to dismiss or defer a permission request -->
    <string name="Permissions_not_now">ಈಗಲ್ಲ</string>
    <!-- Sheet describing step 1 on how to give permissions by opening settings -->
    <string name="PermissionDeniedBottomSheet__1_tap_settings_below">"1. ಕೆಳಗಿನ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ"</string>
    <!-- Sheet describing step 2 on how to give permissions by checking the permissions button in settings where %s will be replaced with an image of a checked button -->
    <string name="PermissionDeniedBottomSheet__2_allow_permission">2. %1$s ಅನುಮತಿ ನೀಡಿ</string>
    <!-- Sheet describing step 2 on how to give permissions by tapping permissions in their settings -->
    <string name="PermissionDeniedBottomSheet__2_tap_permissions">"2. ಅನುಮತಿಗಳು ಅನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ"</string>
    <!-- Sheet describing step 3 on how to give permissions for photos and videos in settings where %s will be replaced with an image of a checked button -->
    <string name="PermissionDeniedBottomSheet__3_allow_permission">"3. %1$s ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳು ಅನುಮತಿಗೆ ಅನುವು ಮಾಡಿಕೊಡಿ"</string>
    <!-- Label for button at the bottom of the sheet which opens the system permission settings -->
    <string name="PermissionDeniedBottomSheet__settings">ಸೆಟ್ಟಿಂಗ್‌ಗಳು</string>
    <!-- Title for dialog shown when a required permission has not been granted -->
    <string name="Permissions_permission_required">ಅನುಮತಿ ಅಗತ್ಯವಿದೆ</string>

    <!-- ListDetailPane -->
    <!-- Content description for the draggable divider between the list and detail panes on large screens -->
    <string name="ListDetailPane__accessibility_pane_divider">ಪೇನ್‌ಗಳನ್ನು ಮರುಗಾತ್ರಗೊಳಿಸಿ</string>
    <!-- Accessibility action label for moving the divider between the list and detail panes to its next position -->
    <string name="ListDetailPane__accessibility_move_pane_divider">ಡಿವೈಡರ್ ಮೂವ್ ಮಾಡಿ</string>

    <!-- StorageUtil -->
    <!-- Format string for displaying a storage path as volume/filename -->
    <string name="StorageUtil__s_s">%1$s/%2$s/</string>

    <!-- DevicePinAuthEducationSheet -->
    <!-- Body of bottom sheet explaining that users should use their device pin or biometrics and not their Signal pin -->
    <string name="LinkDeviceFragment__tap_continue_and_enter_phone">ಮುಂದುವರಿಸಿ ಎಂಬುದನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ ಮತ್ತು ದೃಢೀಕರಿಸಲು ನಿಮ್ಮ ಫೋನ್‌ನ ಲಾಕ್ ನಮೂದಿಸಿ. ನಿಮ್ಮ Signal PIN ಅನ್ನು ನಮೂದಿಸಬೇಡಿ.</string>
    <!-- Button that dismisses the bottom sheet -->
    <string name="LinkDeviceFragment__continue">ಮುಂದುವರಿಸಿ</string>

