<?xml version="1.0" encoding="utf-8"?>
<org.thoughtcrime.securesms.components.SharedContactView
    xmlns:tools="http://schemas.android.com/tools"
    tools:viewBindingIgnore="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shared_contact_view"
    android:layout_width="@dimen/shared_contact_bubble_min_width"
    android:layout_height="wrap_content"
    android:paddingTop="6dp"
    android:paddingBottom="2dp"
    app:contact_titleColor="@color/signal_colorOnSurface"
    app:contact_captionColor="@color/signal_text_secondary"
    app:contact_chevronColor="@color/signal_colorOutline"
    app:contact_footerIconColor="@color/conversation_item_recv_icon_color"
    app:contact_footerAlpha="0.7"
    app:contact_actionTextColor="@color/signal_colorOnSurface"
    app:contact_actionBackgroundColor="@color/signal_colorSurfaceVariantFill"
    tools:background="@color/signal_colorPrimary"/>
