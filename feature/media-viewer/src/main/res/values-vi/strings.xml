<?xml version="1.0" encoding="UTF-8"?>
<resources>
  <!-- MediaViewerScreen -->
  <!-- Toolbar title for media you sent -->
  <string name="MediaViewerScreen__you">Bạn</string>
  <!-- Toolbar title for media you sent to another chat, e.g. \'You to Alice\' -->
  <string name="MediaViewerScreen__you_to_s">Bạn gửi đến %1$s</string>
  <!-- Toolbar title for media a sender sent to a group, e.g. \'Alice to Hiking Group\' -->
  <string name="MediaViewerScreen__s_to_s">%1$s đến %2$s</string>
  <!-- Toolbar title for media a sender sent to you, e.g. \'Alice to you\' -->
  <string name="MediaViewerScreen__s_to_you">%1$s gửi đến bạn</string>
  <!-- Toolbar title for media in your own note-to-self chat -->
  <string name="MediaViewerScreen__note_to_self">Ghi chú</string>
  <!-- Toolbar subtitle when previewing a draft attachment that has not been sent yet -->
  <string name="MediaViewerScreen__draft">Nháp</string>
  <!-- Overflow menu item that opens the media editor -->
  <string name="MediaViewerScreen__edit">Sửa</string>
  <!-- Overflow menu item that saves the media to the device -->
  <string name="MediaViewerScreen__save">Lưu</string>
  <!-- Overflow menu item that deletes the media -->
  <string name="MediaViewerScreen__delete">Xóa</string>
  <!-- Button in the note-to-self delete confirmation dialog that deletes the media -->
  <string name="MediaViewerScreen__delete_dialog_delete">Xóa</string>
  <!-- Title of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_title">Xóa tin nhắn?</string>
  <!-- Body of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_message">Thao tác này sẽ xóa vĩnh viễn tin nhắn này.</string>
  <!-- Delete dialog button that deletes the media only on this device -->
  <string name="MediaViewerScreen__delete_for_me">Xóa cho tôi</string>
  <!-- Delete dialog button that deletes the media for all members of the chat -->
  <string name="MediaViewerScreen__delete_for_everyone">Xóa cho mọi người</string>
  <!-- Generic dialog cancel button -->
  <string name="MediaViewerScreen__cancel">Hủy</string>
  <!-- Suffix appended after a truncated caption, tapped to expand it. Starts with an ellipsis marking where the caption was cut off. -->
  <string name="MediaViewerScreen__read_more">… Đọc thêm</string>
  <!-- Title of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__cant_save_media">Không thể lưu đa phương tiện</string>
  <!-- Body of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__media_offloaded_message">Tập tin đa phương tiện không còn được lưu trên thiết bị này. Bạn có thể thay đổi cài đặt lưu trữ và tải lại tập tin đa phương tiện này qua kết nối Wi-Fi không giới hạn dung lượng.</string>
  <!-- Button on the offloaded-media dialog that opens storage settings -->
  <string name="MediaViewerScreen__view_storage_settings">Xem cài đặt lưu trữ</string>
  <!-- Generic dialog confirmation button -->
  <string name="MediaViewerScreen__ok">OK</string>
  <!-- Content description of the toolbar back button -->
  <string name="MediaViewerScreen__navigate_back">Quay lại</string>
  <!-- Content description of the toolbar overflow menu button -->
  <string name="MediaViewerScreen__more_options">Tùy chọn khác</string>
  <!-- Content description of the share button -->
  <string name="MediaViewerScreen__share">Chia sẻ</string>
  <!-- Content description of the forward button -->
  <string name="MediaViewerScreen__forward">Chuyển tiếp</string>
  <!-- Content description of the video play button -->
  <string name="MediaViewerScreen__play">Chạy</string>
  <!-- Content description of the video pause button -->
  <string name="MediaViewerScreen__pause">Tạm ngưng</string>
  <!-- Content description of the video rewind button -->
  <string name="MediaViewerScreen__rewind">Tua ngược lại</string>
  <!-- Content description of the video fast-forward button -->
  <string name="MediaViewerScreen__fast_forward">Tua nhanh</string>
  <!-- Content description of a thumbnail in the album rail at the bottom of the screen -->
  <string name="MediaViewerScreen__album_rail_thumbnail">Hình thu nhỏ tập tin đa phương tiện</string>
  <!-- Time left in the playing video, shown at the end of the seek bar. %1$s is the remaining time, e.g. 0:38. The leading minus sign marks it as a countdown. -->
  <string name="MediaViewerScreen__remaining_time">−%1$s</string>
</resources>
