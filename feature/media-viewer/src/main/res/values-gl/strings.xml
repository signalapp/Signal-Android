<?xml version="1.0" encoding="UTF-8"?>
<resources>
  <!-- MediaViewerScreen -->
  <!-- Toolbar title for media you sent -->
  <string name="MediaViewerScreen__you">Ti</string>
  <!-- Toolbar title for media you sent to another chat, e.g. \'You to Alice\' -->
  <string name="MediaViewerScreen__you_to_s">Ti a %1$s</string>
  <!-- Toolbar title for media a sender sent to a group, e.g. \'Alice to Hiking Group\' -->
  <string name="MediaViewerScreen__s_to_s">%1$s a %2$s</string>
  <!-- Toolbar title for media a sender sent to you, e.g. \'Alice to you\' -->
  <string name="MediaViewerScreen__s_to_you">%1$s a ti</string>
  <!-- Toolbar title for media in your own note-to-self chat -->
  <string name="MediaViewerScreen__note_to_self">Notas privadas</string>
  <!-- Toolbar subtitle when previewing a draft attachment that has not been sent yet -->
  <string name="MediaViewerScreen__draft">Borrador</string>
  <!-- Overflow menu item that opens the media editor -->
  <string name="MediaViewerScreen__edit">Editar</string>
  <!-- Overflow menu item that saves the media to the device -->
  <string name="MediaViewerScreen__save">Gardar</string>
  <!-- Overflow menu item that deletes the media -->
  <string name="MediaViewerScreen__delete">Borrar</string>
  <!-- Button in the note-to-self delete confirmation dialog that deletes the media -->
  <string name="MediaViewerScreen__delete_dialog_delete">Borrar</string>
  <!-- Title of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_title">Borrar mensaxe?</string>
  <!-- Body of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_message">Isto borrará de xeito permanente esta mensaxe.</string>
  <!-- Delete dialog button that deletes the media only on this device -->
  <string name="MediaViewerScreen__delete_for_me">Eliminar para min</string>
  <!-- Delete dialog button that deletes the media for all members of the chat -->
  <string name="MediaViewerScreen__delete_for_everyone">Eliminar para todos</string>
  <!-- Generic dialog cancel button -->
  <string name="MediaViewerScreen__cancel">Cancelar</string>
  <!-- Suffix appended after a truncated caption, tapped to expand it. Starts with an ellipsis marking where the caption was cut off. -->
  <string name="MediaViewerScreen__read_more">… Máis información</string>
  <!-- Title of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__cant_save_media">Non se poden gardar os arquivos</string>
  <!-- Body of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__media_offloaded_message">Os arquivos multimedia xa non se almacenan neste dispositivo. Podes cambiar a configuración de almacenamento e volver descargar os arquivos cunha conexión sen límite de datos.</string>
  <!-- Button on the offloaded-media dialog that opens storage settings -->
  <string name="MediaViewerScreen__view_storage_settings">Ver configuración de almacenamento</string>
  <!-- Generic dialog confirmation button -->
  <string name="MediaViewerScreen__ok">Aceptar</string>
  <!-- Content description of the toolbar back button -->
  <string name="MediaViewerScreen__navigate_back">Retroceder</string>
  <!-- Content description of the toolbar overflow menu button -->
  <string name="MediaViewerScreen__more_options">Máis opcións</string>
  <!-- Content description of the share button -->
  <string name="MediaViewerScreen__share">Compartir</string>
  <!-- Content description of the forward button -->
  <string name="MediaViewerScreen__forward">Reenviar</string>
  <!-- Content description of the video play button -->
  <string name="MediaViewerScreen__play">Reproducir</string>
  <!-- Content description of the video pause button -->
  <string name="MediaViewerScreen__pause">Pausar</string>
  <!-- Content description of the video rewind button -->
  <string name="MediaViewerScreen__rewind">Retroceder</string>
  <!-- Content description of the video fast-forward button -->
  <string name="MediaViewerScreen__fast_forward">Avanzar</string>
  <!-- Content description of a thumbnail in the album rail at the bottom of the screen -->
  <string name="MediaViewerScreen__album_rail_thumbnail">Miniatura do contido multimedia</string>
  <!-- Time left in the playing video, shown at the end of the seek bar. %1$s is the remaining time, e.g. 0:38. The leading minus sign marks it as a countdown. -->
  <string name="MediaViewerScreen__remaining_time">-%1$s</string>
</resources>
