<?xml version="1.0" encoding="UTF-8"?>
<resources>
  <!-- MediaViewerScreen -->
  <!-- Toolbar title for media you sent -->
  <string name="MediaViewerScreen__you">आपण</string>
  <!-- Toolbar title for media you sent to another chat, e.g. \'You to Alice\' -->
  <string name="MediaViewerScreen__you_to_s">आपल्याकडून %1$s ला</string>
  <!-- Toolbar title for media a sender sent to a group, e.g. \'Alice to Hiking Group\' -->
  <string name="MediaViewerScreen__s_to_s">%1$s ते %2$s</string>
  <!-- Toolbar title for media a sender sent to you, e.g. \'Alice to you\' -->
  <string name="MediaViewerScreen__s_to_you">%1$s कडून आपणाला</string>
  <!-- Toolbar title for media in your own note-to-self chat -->
  <string name="MediaViewerScreen__note_to_self">स्वतःला नोंद</string>
  <!-- Toolbar subtitle when previewing a draft attachment that has not been sent yet -->
  <string name="MediaViewerScreen__draft">मसुदा</string>
  <!-- Overflow menu item that opens the media editor -->
  <string name="MediaViewerScreen__edit">संपादन</string>
  <!-- Overflow menu item that saves the media to the device -->
  <string name="MediaViewerScreen__save">जतन करा</string>
  <!-- Overflow menu item that deletes the media -->
  <string name="MediaViewerScreen__delete">हटवा</string>
  <!-- Button in the note-to-self delete confirmation dialog that deletes the media -->
  <string name="MediaViewerScreen__delete_dialog_delete">हटवा</string>
  <!-- Title of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_title">संदेश हटवायचा?</string>
  <!-- Body of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_message">हे कायमचे हा संदेश हटवेल.</string>
  <!-- Delete dialog button that deletes the media only on this device -->
  <string name="MediaViewerScreen__delete_for_me">माझ्यासाठी हटवा</string>
  <!-- Delete dialog button that deletes the media for all members of the chat -->
  <string name="MediaViewerScreen__delete_for_everyone">प्रत्येकासाठी हटवा</string>
  <!-- Generic dialog cancel button -->
  <string name="MediaViewerScreen__cancel">रद्द करा</string>
  <!-- Suffix appended after a truncated caption, tapped to expand it. Starts with an ellipsis marking where the caption was cut off. -->
  <string name="MediaViewerScreen__read_more">… Read more</string>
  <!-- Title of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__cant_save_media">मीडिया जतन करता येणार नाही</string>
  <!-- Body of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__media_offloaded_message">This media is no longer stored on this device. You can change your storage settings and re-download this media over an unmetered Wi-Fi connection.</string>
  <!-- Button on the offloaded-media dialog that opens storage settings -->
  <string name="MediaViewerScreen__view_storage_settings">साठवणीच्या सेटिंग्ज बघा</string>
  <!-- Generic dialog confirmation button -->
  <string name="MediaViewerScreen__ok">ठीक</string>
  <!-- Content description of the toolbar back button -->
  <string name="MediaViewerScreen__navigate_back">मागे नेव्हिगेट करा</string>
  <!-- Content description of the toolbar overflow menu button -->
  <string name="MediaViewerScreen__more_options">अधिक पर्याय</string>
  <!-- Content description of the share button -->
  <string name="MediaViewerScreen__share">सामायिक करा</string>
  <!-- Content description of the forward button -->
  <string name="MediaViewerScreen__forward">फॉर्वर्ड करा</string>
  <!-- Content description of the video play button -->
  <string name="MediaViewerScreen__play">प्ले करा</string>
  <!-- Content description of the video pause button -->
  <string name="MediaViewerScreen__pause">विराम द्या</string>
  <!-- Content description of the video rewind button -->
  <string name="MediaViewerScreen__rewind">Rewind</string>
  <!-- Content description of the video fast-forward button -->
  <string name="MediaViewerScreen__fast_forward">Fast-forward</string>
  <!-- Content description of a thumbnail in the album rail at the bottom of the screen -->
  <string name="MediaViewerScreen__album_rail_thumbnail">Media thumbnail</string>
  <!-- Time left in the playing video, shown at the end of the seek bar. %1$s is the remaining time, e.g. 0:38. The leading minus sign marks it as a countdown. -->
  <string name="MediaViewerScreen__remaining_time">−%1$s</string>
</resources>
