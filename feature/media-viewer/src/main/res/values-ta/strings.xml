<?xml version="1.0" encoding="UTF-8"?>
<resources>
  <!-- MediaViewerScreen -->
  <!-- Toolbar title for media you sent -->
  <string name="MediaViewerScreen__you">நீங்கள்</string>
  <!-- Toolbar title for media you sent to another chat, e.g. \'You to Alice\' -->
  <string name="MediaViewerScreen__you_to_s">உங்களிடமிருந்து %1$sக்கு</string>
  <!-- Toolbar title for media a sender sent to a group, e.g. \'Alice to Hiking Group\' -->
  <string name="MediaViewerScreen__s_to_s">%1$s to %2$s</string>
  <!-- Toolbar title for media a sender sent to you, e.g. \'Alice to you\' -->
  <string name="MediaViewerScreen__s_to_you">%1$s இடமிருந்து உங்களுக்கு</string>
  <!-- Toolbar title for media in your own note-to-self chat -->
  <string name="MediaViewerScreen__note_to_self">சுய குறிப்பு</string>
  <!-- Toolbar subtitle when previewing a draft attachment that has not been sent yet -->
  <string name="MediaViewerScreen__draft">வரைவு</string>
  <!-- Overflow menu item that opens the media editor -->
  <string name="MediaViewerScreen__edit">திருத்துக</string>
  <!-- Overflow menu item that saves the media to the device -->
  <string name="MediaViewerScreen__save">சேமி</string>
  <!-- Overflow menu item that deletes the media -->
  <string name="MediaViewerScreen__delete">நீக்கு</string>
  <!-- Button in the note-to-self delete confirmation dialog that deletes the media -->
  <string name="MediaViewerScreen__delete_dialog_delete">நீக்கு</string>
  <!-- Title of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_title">செய்தியை நீக்க வேண்டுமா?</string>
  <!-- Body of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_message">இது இந்த செய்தியை நிரந்தரமாக நீக்கும்.</string>
  <!-- Delete dialog button that deletes the media only on this device -->
  <string name="MediaViewerScreen__delete_for_me">எனக்கு மட்டும் நீக்கு</string>
  <!-- Delete dialog button that deletes the media for all members of the chat -->
  <string name="MediaViewerScreen__delete_for_everyone">அனைவருக்கும் நீக்கு</string>
  <!-- Generic dialog cancel button -->
  <string name="MediaViewerScreen__cancel">ரத்துசெய்</string>
  <!-- Suffix appended after a truncated caption, tapped to expand it. Starts with an ellipsis marking where the caption was cut off. -->
  <string name="MediaViewerScreen__read_more">…மேலும் படி</string>
  <!-- Title of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__cant_save_media">ஊடகத்தைச் சேமிக்க முடியவில்லை</string>
  <!-- Body of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__media_offloaded_message">இந்த ஊடகம் இப்போது இந்தச் சாதனத்தில் சேமிக்கப்படவில்லை. உங்கள் சேமிப்பிட அமைப்புகளை மாற்றி, அளவிடப்படாத Wi-Fi இணைப்பின் மூலம் இந்த ஊடகத்தை மீண்டும் பதிவிறக்கலாம்.</string>
  <!-- Button on the offloaded-media dialog that opens storage settings -->
  <string name="MediaViewerScreen__view_storage_settings">சேமிப்பக அமைப்புகளைக் காண்க</string>
  <!-- Generic dialog confirmation button -->
  <string name="MediaViewerScreen__ok">சரி</string>
  <!-- Content description of the toolbar back button -->
  <string name="MediaViewerScreen__navigate_back">முந்தைய திரைக்குச் செல்</string>
  <!-- Content description of the toolbar overflow menu button -->
  <string name="MediaViewerScreen__more_options">அதிக விருப்பத்தேர்வுகள்</string>
  <!-- Content description of the share button -->
  <string name="MediaViewerScreen__share">பகிர்</string>
  <!-- Content description of the forward button -->
  <string name="MediaViewerScreen__forward">முன்னனுப்புக</string>
  <!-- Content description of the video play button -->
  <string name="MediaViewerScreen__play">இயக்கு</string>
  <!-- Content description of the video pause button -->
  <string name="MediaViewerScreen__pause">நிறுத்து</string>
  <!-- Content description of the video rewind button -->
  <string name="MediaViewerScreen__rewind">பின்னனுப்புக</string>
  <!-- Content description of the video fast-forward button -->
  <string name="MediaViewerScreen__fast_forward">விரைவாக முன்னனுப்புக</string>
  <!-- Content description of a thumbnail in the album rail at the bottom of the screen -->
  <string name="MediaViewerScreen__album_rail_thumbnail">ஊடகச் சிறுபடம்</string>
  <!-- Time left in the playing video, shown at the end of the seek bar. %1$s is the remaining time, e.g. 0:38. The leading minus sign marks it as a countdown. -->
  <string name="MediaViewerScreen__remaining_time">−%1$s</string>
</resources>
