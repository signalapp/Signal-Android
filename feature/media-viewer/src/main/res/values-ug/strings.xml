<?xml version="1.0" encoding="UTF-8"?>
<resources>
  <!-- MediaViewerScreen -->
  <!-- Toolbar title for media you sent -->
  <string name="MediaViewerScreen__you">سىز</string>
  <!-- Toolbar title for media you sent to another chat, e.g. \'You to Alice\' -->
  <string name="MediaViewerScreen__you_to_s">سىزدىن %1$s گە</string>
  <!-- Toolbar title for media a sender sent to a group, e.g. \'Alice to Hiking Group\' -->
  <string name="MediaViewerScreen__s_to_s">%1$s دىن%2$s غىچە</string>
  <!-- Toolbar title for media a sender sent to you, e.g. \'Alice to you\' -->
  <string name="MediaViewerScreen__s_to_you">%1$s دىن سىزگە</string>
  <!-- Toolbar title for media in your own note-to-self chat -->
  <string name="MediaViewerScreen__note_to_self">ئۆزۈمگە ئەسلەتمە</string>
  <!-- Toolbar subtitle when previewing a draft attachment that has not been sent yet -->
  <string name="MediaViewerScreen__draft">ئارگىنال</string>
  <!-- Overflow menu item that opens the media editor -->
  <string name="MediaViewerScreen__edit">تەھرىرلەش</string>
  <!-- Overflow menu item that saves the media to the device -->
  <string name="MediaViewerScreen__save">ساقلاش</string>
  <!-- Overflow menu item that deletes the media -->
  <string name="MediaViewerScreen__delete">ئۆچۈرۈش</string>
  <!-- Button in the note-to-self delete confirmation dialog that deletes the media -->
  <string name="MediaViewerScreen__delete_dialog_delete">ئۆچۈرۈش</string>
  <!-- Title of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_title">ئۇچۇرنى ئۆچۈرەمسىز؟</string>
  <!-- Body of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_message">بۇ ئۇچۇر مەڭگۈلۈك ئۆچۈرۈلىدۇ.</string>
  <!-- Delete dialog button that deletes the media only on this device -->
  <string name="MediaViewerScreen__delete_for_me">مەن ئۈچۈن ئۆچۈرۈش</string>
  <!-- Delete dialog button that deletes the media for all members of the chat -->
  <string name="MediaViewerScreen__delete_for_everyone">ھەممەيلەن ئۈچۈن ئۆچەر</string>
  <!-- Generic dialog cancel button -->
  <string name="MediaViewerScreen__cancel">بىكار قىلىش</string>
  <!-- Suffix appended after a truncated caption, tapped to expand it. Starts with an ellipsis marking where the caption was cut off. -->
  <string name="MediaViewerScreen__read_more">… تېخىمۇ كۆپ تەپسىلاتى</string>
  <!-- Title of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__cant_save_media">مېدىيانى ساقلىغىلى بولمىدى</string>
  <!-- Body of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__media_offloaded_message">بۇ مېدىيا ئەمدى بۇ ئۈسكۈنىدە ساقلانمايدۇ. ساقلاش تەڭشەكلىرىڭىزنى ئۆزگەرتىپ، بۇ مېدىيا ھۆججىتىنى، سانلىق مەلۇمات ئىشلىتىش مىقدارى چەكلەنمىگەن Wi-Fi ئۇلىنىشى ئارقىلىق قايتا چۈشۈرەلەيسىز.</string>
  <!-- Button on the offloaded-media dialog that opens storage settings -->
  <string name="MediaViewerScreen__view_storage_settings">ساقلاش بوشلۇقى تەڭشەكلىرىنى كۆرۈش</string>
  <!-- Generic dialog confirmation button -->
  <string name="MediaViewerScreen__ok">بولىدۇ</string>
  <!-- Content description of the toolbar back button -->
  <string name="MediaViewerScreen__navigate_back">كەينىگە قايتۇرۇش</string>
  <!-- Content description of the toolbar overflow menu button -->
  <string name="MediaViewerScreen__more_options">تېخىمۇ كۆپ تاللاش</string>
  <!-- Content description of the share button -->
  <string name="MediaViewerScreen__share">ھەمبەھىرلە</string>
  <!-- Content description of the forward button -->
  <string name="MediaViewerScreen__forward">ئۇلاپ يوللا</string>
  <!-- Content description of the video play button -->
  <string name="MediaViewerScreen__play">قويۇش</string>
  <!-- Content description of the video pause button -->
  <string name="MediaViewerScreen__pause">توختىتىش</string>
  <!-- Content description of the video rewind button -->
  <string name="MediaViewerScreen__rewind">ئارقىغا تېز ئۆتكۈزۈش</string>
  <!-- Content description of the video fast-forward button -->
  <string name="MediaViewerScreen__fast_forward">ئالدىغا تېز سۈرۈش</string>
  <!-- Content description of a thumbnail in the album rail at the bottom of the screen -->
  <string name="MediaViewerScreen__album_rail_thumbnail">مېدىيا كىچىك كۆرۈنۈشى</string>
  <!-- Time left in the playing video, shown at the end of the seek bar. %1$s is the remaining time, e.g. 0:38. The leading minus sign marks it as a countdown. -->
  <string name="MediaViewerScreen__remaining_time">−%1$s</string>
</resources>
