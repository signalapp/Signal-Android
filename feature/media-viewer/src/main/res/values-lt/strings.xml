<?xml version="1.0" encoding="UTF-8"?>
<resources>
  <!-- MediaViewerScreen -->
  <!-- Toolbar title for media you sent -->
  <string name="MediaViewerScreen__you">Jūs</string>
  <!-- Toolbar title for media you sent to another chat, e.g. \'You to Alice\' -->
  <string name="MediaViewerScreen__you_to_s">Tu siuntei į %1$s</string>
  <!-- Toolbar title for media a sender sent to a group, e.g. \'Alice to Hiking Group\' -->
  <string name="MediaViewerScreen__s_to_s">%1$s naudotojui %2$s</string>
  <!-- Toolbar title for media a sender sent to you, e.g. \'Alice to you\' -->
  <string name="MediaViewerScreen__s_to_you">%1$s siuntė jums</string>
  <!-- Toolbar title for media in your own note-to-self chat -->
  <string name="MediaViewerScreen__note_to_self">Priminimas sau</string>
  <!-- Toolbar subtitle when previewing a draft attachment that has not been sent yet -->
  <string name="MediaViewerScreen__draft">Juodraštis</string>
  <!-- Overflow menu item that opens the media editor -->
  <string name="MediaViewerScreen__edit">Redaguoti</string>
  <!-- Overflow menu item that saves the media to the device -->
  <string name="MediaViewerScreen__save">Įrašyti</string>
  <!-- Overflow menu item that deletes the media -->
  <string name="MediaViewerScreen__delete">Ištrinti</string>
  <!-- Button in the note-to-self delete confirmation dialog that deletes the media -->
  <string name="MediaViewerScreen__delete_dialog_delete">Ištrinti</string>
  <!-- Title of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_title">Ištrinti žinutę?</string>
  <!-- Body of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_message">Tai visiems laikams ištrins šią žinutę.</string>
  <!-- Delete dialog button that deletes the media only on this device -->
  <string name="MediaViewerScreen__delete_for_me">Ištrinti man</string>
  <!-- Delete dialog button that deletes the media for all members of the chat -->
  <string name="MediaViewerScreen__delete_for_everyone">Ištrinti visiems</string>
  <!-- Generic dialog cancel button -->
  <string name="MediaViewerScreen__cancel">Atšaukti</string>
  <!-- Suffix appended after a truncated caption, tapped to expand it. Starts with an ellipsis marking where the caption was cut off. -->
  <string name="MediaViewerScreen__read_more">… Skaityti daugiau</string>
  <!-- Title of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__cant_save_media">Medijos išsaugoti neįmanoma</string>
  <!-- Body of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__media_offloaded_message">Šis įrašas nebesaugomas šiame įrenginyje. Galite pakeisti saugyklos nustatymus ir iš naujo atsisiųsti šį įrašą per neribojamą „Wi-Fi“ tinklą.</string>
  <!-- Button on the offloaded-media dialog that opens storage settings -->
  <string name="MediaViewerScreen__view_storage_settings">Rodyti saugyklos nustatymus</string>
  <!-- Generic dialog confirmation button -->
  <string name="MediaViewerScreen__ok">Gerai</string>
  <!-- Content description of the toolbar back button -->
  <string name="MediaViewerScreen__navigate_back">Grįžti atgal</string>
  <!-- Content description of the toolbar overflow menu button -->
  <string name="MediaViewerScreen__more_options">Daugiau parinkčių</string>
  <!-- Content description of the share button -->
  <string name="MediaViewerScreen__share">Bendrinti</string>
  <!-- Content description of the forward button -->
  <string name="MediaViewerScreen__forward">Persiųsti</string>
  <!-- Content description of the video play button -->
  <string name="MediaViewerScreen__play">Groti</string>
  <!-- Content description of the video pause button -->
  <string name="MediaViewerScreen__pause">Pristabdyti</string>
  <!-- Content description of the video rewind button -->
  <string name="MediaViewerScreen__rewind">Atsukti</string>
  <!-- Content description of the video fast-forward button -->
  <string name="MediaViewerScreen__fast_forward">Paskubinti</string>
  <!-- Content description of a thumbnail in the album rail at the bottom of the screen -->
  <string name="MediaViewerScreen__album_rail_thumbnail">Įrašo miniatiūra</string>
  <!-- Time left in the playing video, shown at the end of the seek bar. %1$s is the remaining time, e.g. 0:38. The leading minus sign marks it as a countdown. -->
  <string name="MediaViewerScreen__remaining_time">−%1$s</string>
</resources>
