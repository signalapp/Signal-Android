<?xml version="1.0" encoding="UTF-8"?>
<resources>
  <!-- MediaViewerScreen -->
  <!-- Toolbar title for media you sent -->
  <string name="MediaViewerScreen__you">আপনি</string>
  <!-- Toolbar title for media you sent to another chat, e.g. \'You to Alice\' -->
  <string name="MediaViewerScreen__you_to_s">আপনার কাছ থেকে %1$s-এর কাছে</string>
  <!-- Toolbar title for media a sender sent to a group, e.g. \'Alice to Hiking Group\' -->
  <string name="MediaViewerScreen__s_to_s">%1$s থেকে %2$s</string>
  <!-- Toolbar title for media a sender sent to you, e.g. \'Alice to you\' -->
  <string name="MediaViewerScreen__s_to_you">%1$s-এর কাছ থেকে আপনার কাছে</string>
  <!-- Toolbar title for media in your own note-to-self chat -->
  <string name="MediaViewerScreen__note_to_self">নিজের জন্য নোট</string>
  <!-- Toolbar subtitle when previewing a draft attachment that has not been sent yet -->
  <string name="MediaViewerScreen__draft">খসড়া</string>
  <!-- Overflow menu item that opens the media editor -->
  <string name="MediaViewerScreen__edit">এডিট করুন</string>
  <!-- Overflow menu item that saves the media to the device -->
  <string name="MediaViewerScreen__save">সেভ করুন</string>
  <!-- Overflow menu item that deletes the media -->
  <string name="MediaViewerScreen__delete">মুছে ফেলুন</string>
  <!-- Button in the note-to-self delete confirmation dialog that deletes the media -->
  <string name="MediaViewerScreen__delete_dialog_delete">মুছে ফেলুন</string>
  <!-- Title of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_title">বার্তা মুছে ফেলবেন?</string>
  <!-- Body of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_message">এর ফলে এই বার্তাটি চিরতরে মুছে যাবে।</string>
  <!-- Delete dialog button that deletes the media only on this device -->
  <string name="MediaViewerScreen__delete_for_me">আমার জন্য মুছে ফেলুন</string>
  <!-- Delete dialog button that deletes the media for all members of the chat -->
  <string name="MediaViewerScreen__delete_for_everyone">প্রত্যেকের জন্য মুছে ফেলুন</string>
  <!-- Generic dialog cancel button -->
  <string name="MediaViewerScreen__cancel">বাতিল করুন</string>
  <!-- Suffix appended after a truncated caption, tapped to expand it. Starts with an ellipsis marking where the caption was cut off. -->
  <string name="MediaViewerScreen__read_more">… আরও পড়ুন</string>
  <!-- Title of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__cant_save_media">মিডিয়া সংরক্ষণ করা যায়নি</string>
  <!-- Body of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__media_offloaded_message">এই মিডিয়াটি এখন আর এই ডিভাইসে সংরক্ষিত নেই। আপনি আপনার স্টোরেজ সেটিংস পরিবর্তন করতে পারেন এবং আনমিটারড (ডেটা লিমিট নেই এমন) Wi-Fi সংযোগের মাধ্যমে এই মিডিয়াটি পুনরায় ডাউনলোড করতে পারেন।</string>
  <!-- Button on the offloaded-media dialog that opens storage settings -->
  <string name="MediaViewerScreen__view_storage_settings">স্টোরেজ সেটিংস দেখুন</string>
  <!-- Generic dialog confirmation button -->
  <string name="MediaViewerScreen__ok">ঠিক আছে</string>
  <!-- Content description of the toolbar back button -->
  <string name="MediaViewerScreen__navigate_back">ফিরে যান</string>
  <!-- Content description of the toolbar overflow menu button -->
  <string name="MediaViewerScreen__more_options">আরো অপশন</string>
  <!-- Content description of the share button -->
  <string name="MediaViewerScreen__share">শেয়ার করুন</string>
  <!-- Content description of the forward button -->
  <string name="MediaViewerScreen__forward">ফরওয়ার্ড</string>
  <!-- Content description of the video play button -->
  <string name="MediaViewerScreen__play">প্লে করুন</string>
  <!-- Content description of the video pause button -->
  <string name="MediaViewerScreen__pause">পজ করুন</string>
  <!-- Content description of the video rewind button -->
  <string name="MediaViewerScreen__rewind">রিওয়াইন্ড</string>
  <!-- Content description of the video fast-forward button -->
  <string name="MediaViewerScreen__fast_forward">ফাস্ট ফরওয়ার্ড</string>
  <!-- Content description of a thumbnail in the album rail at the bottom of the screen -->
  <string name="MediaViewerScreen__album_rail_thumbnail">মিডিয়া থাম্বনেইল</string>
  <!-- Time left in the playing video, shown at the end of the seek bar. %1$s is the remaining time, e.g. 0:38. The leading minus sign marks it as a countdown. -->
  <string name="MediaViewerScreen__remaining_time">−%1$s</string>
</resources>
