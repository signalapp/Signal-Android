  <string name="MediaViewerScreen__media_delete_confirmation_message">การดำเนินการนี้จะลบข้อความนี้โดยถาวร</string>
  <!-- Delete dialog button that deletes the media only on this device -->
  <string name="MediaViewerScreen__delete_for_me">ลบของฉัน</string>
  <!-- Delete dialog button that deletes the media for all members of the chat -->
  <string name="MediaViewerScreen__delete_for_everyone">ลบสำหรับทุกคน</string>
  <!-- Generic dialog cancel button -->
  <string name="MediaViewerScreen__cancel">ยกเลิก</string>
  <!-- Suffix appended after a truncated caption, tapped to expand it. Starts with an ellipsis marking where the caption was cut off. -->
  <string name="MediaViewerScreen__read_more">… อ่านเพิ่มเติม</string>
  <!-- Title of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__cant_save_media">ไม่สามารถบันทึกไฟล์สื่อได้</string>
