  <string name="MediaViewerScreen__media_offloaded_message">ไฟล์สื่อนี้ไม่ได้จับเก็บอยู่บนอุปกรณ์เครื่องนี้แล้ว คุณสามารถเปลี่ยนการตั้งค่าพื้นที่จัดเก็บแล้วดาวน์โหลดไฟล์สื่อนี้อีกครั้งผ่านการเชื่อมต่อ Wi-Fi แบบไม่จำกัดการใช้งาน</string>
  <!-- Button on the offloaded-media dialog that opens storage settings -->
  <string name="MediaViewerScreen__view_storage_settings">ดูการตั้งค่าพื้นที่จัดเก็บ</string>
  <!-- Generic dialog confirmation button -->
  <string name="MediaViewerScreen__ok">ตกลง</string>
  <!-- Content description of the toolbar back button -->
  <string name="MediaViewerScreen__navigate_back">กลับไป</string>
  <!-- Content description of the toolbar overflow menu button -->
  <string name="MediaViewerScreen__more_options">ตัวเลือกเพิ่มเติม</string>
  <!-- Content description of the share button -->
  <string name="MediaViewerScreen__share">แชร์</string>
  <!-- Content description of the forward button -->
  <string name="MediaViewerScreen__forward">ส่งต่อ</string>
  <!-- Content description of the video play button -->
  <string name="MediaViewerScreen__play">เล่น</string>
  <!-- Content description of the video pause button -->
  <string name="MediaViewerScreen__pause">หยุดชั่วคราว</string>
  <!-- Content description of the video rewind button -->
  <string name="MediaViewerScreen__rewind">กรอกลับ</string>
  <!-- Content description of the video fast-forward button -->
  <string name="MediaViewerScreen__fast_forward">กรอไปข้างหน้า</string>
  <!-- Content description of a thumbnail in the album rail at the bottom of the screen -->
  <string name="MediaViewerScreen__album_rail_thumbnail">ภาพปกของสื่อ</string>
  <!-- Time left in the playing video, shown at the end of the seek bar. %1$s is the remaining time, e.g. 0:38. The leading minus sign marks it as a countdown. -->
  <string name="MediaViewerScreen__remaining_time">−%1$s</string>
</resources>
