<?xml version="1.0" encoding="UTF-8"?>
<resources>
  <!-- MediaViewerScreen -->
  <!-- Toolbar title for media you sent -->
  <string name="MediaViewerScreen__you">ನೀವು</string>
  <!-- Toolbar title for media you sent to another chat, e.g. \'You to Alice\' -->
  <string name="MediaViewerScreen__you_to_s">ನಿಮ್ಮಿಂದ %1$s ಅವರಿಗೆ</string>
  <!-- Toolbar title for media a sender sent to a group, e.g. \'Alice to Hiking Group\' -->
  <string name="MediaViewerScreen__s_to_s">%1$s ಗೆ %2$s</string>
  <!-- Toolbar title for media a sender sent to you, e.g. \'Alice to you\' -->
  <string name="MediaViewerScreen__s_to_you">%1$s ಅವರಿಂದ ನಿಮಗೆ</string>
  <!-- Toolbar title for media in your own note-to-self chat -->
  <string name="MediaViewerScreen__note_to_self">ಸ್ವಯಂ ಬಳಕೆಗೆ ಟಿಪ್ಪಣಿ</string>
  <!-- Toolbar subtitle when previewing a draft attachment that has not been sent yet -->
  <string name="MediaViewerScreen__draft">ಡ್ರಾಫ್ಟ್</string>
  <!-- Overflow menu item that opens the media editor -->
  <string name="MediaViewerScreen__edit">ಎಡಿಟ್ ಮಾಡಿ</string>
  <!-- Overflow menu item that saves the media to the device -->
  <string name="MediaViewerScreen__save">ಉಳಿಸಿ</string>
  <!-- Overflow menu item that deletes the media -->
  <string name="MediaViewerScreen__delete">ಅಳಿಸಿ</string>
  <!-- Button in the note-to-self delete confirmation dialog that deletes the media -->
  <string name="MediaViewerScreen__delete_dialog_delete">ಅಳಿಸಿ</string>
  <!-- Title of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_title">ಮೆಸೇಜನ್ನು ಅಳಿಸುವುದೇ?</string>
  <!-- Body of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_message">ಇದು ಶಾಶ್ವತವಾಗಿ ಈ ಸಂದೇಶವನ್ನು ಅಳಿಸುತ್ತದೆ.</string>
  <!-- Delete dialog button that deletes the media only on this device -->
  <string name="MediaViewerScreen__delete_for_me">ನನಗೆ ಮಾತ್ರ ಅಳಿಸಿ</string>
  <!-- Delete dialog button that deletes the media for all members of the chat -->
  <string name="MediaViewerScreen__delete_for_everyone">ಎಲ್ಲರಿಗೂ ಅಳಿಸಿ</string>
  <!-- Generic dialog cancel button -->
  <string name="MediaViewerScreen__cancel">ರದ್ದುಮಾಡಿ</string>
  <!-- Suffix appended after a truncated caption, tapped to expand it. Starts with an ellipsis marking where the caption was cut off. -->
  <string name="MediaViewerScreen__read_more">… ಇನ್ನಷ್ಟು ಓದಿ</string>
  <!-- Title of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__cant_save_media">ಮೀಡಿಯಾವನ್ನು ಸೇವ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ</string>
  <!-- Body of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__media_offloaded_message">ಈ ಮೀಡಿಯಾ ಇನ್ನು ಮುಂದೆ ಈ ಸಾಧನದಲ್ಲಿ ಸಂಗ್ರಹವಾಗಿರುವುದಿಲ್ಲ. ನಿಮ್ಮ ಸಂಗ್ರಹಣೆ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ನೀವು ಬದಲಾಯಿಸಬಹುದು ಮತ್ತು ಅನಿಯಮಿತ Wi-Fi ಕನೆಕ್ಷನ್ ಮೂಲಕ ಈ ಮೀಡಿಯಾವನ್ನು ಮರುಡೌನ್‌ಲೋಡ್ ಮಾಡಬಹುದು.</string>
  <!-- Button on the offloaded-media dialog that opens storage settings -->
  <string name="MediaViewerScreen__view_storage_settings">ಸಂಗ್ರಹಣೆ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ವೀಕ್ಷಿಸಿ</string>
  <!-- Generic dialog confirmation button -->
  <string name="MediaViewerScreen__ok">ಓಕೆ</string>
  <!-- Content description of the toolbar back button -->
  <string name="MediaViewerScreen__navigate_back">ಹಿಂದಕ್ಕೆ ನ್ಯಾವಿಗೇಟ್ ಮಾಡಿ</string>
  <!-- Content description of the toolbar overflow menu button -->
  <string name="MediaViewerScreen__more_options">ಇನ್ನಷ್ಟು ಆಯ್ಕೆಗಳು</string>
  <!-- Content description of the share button -->
  <string name="MediaViewerScreen__share">ಹಂಚಿಕೊಳ್ಳಿ</string>
  <!-- Content description of the forward button -->
  <string name="MediaViewerScreen__forward">ಫಾರ್ವರ್ಡ್</string>
  <!-- Content description of the video play button -->
  <string name="MediaViewerScreen__play">ಪ್ಲೇ ಮಾಡಿ</string>
  <!-- Content description of the video pause button -->
  <string name="MediaViewerScreen__pause">ಸ್ಥಗಿತಗೊಳಿಸಿ</string>
  <!-- Content description of the video rewind button -->
  <string name="MediaViewerScreen__rewind">ರಿವೈಂಡ್ ಮಾಡಿ</string>
  <!-- Content description of the video fast-forward button -->
  <string name="MediaViewerScreen__fast_forward">ಫಾಸ್ಟ್-ಫಾರ್ವರ್ಡ್</string>
  <!-- Content description of a thumbnail in the album rail at the bottom of the screen -->
  <string name="MediaViewerScreen__album_rail_thumbnail">ಮೀಡಿಯಾ ಥಂಬ್‌ನೇಲ್</string>
  <!-- Time left in the playing video, shown at the end of the seek bar. %1$s is the remaining time, e.g. 0:38. The leading minus sign marks it as a countdown. -->
  <string name="MediaViewerScreen__remaining_time">−%1$s</string>
</resources>
