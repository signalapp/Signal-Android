<?xml version="1.0" encoding="UTF-8"?>
<resources>
  <!-- MediaViewerScreen -->
  <!-- Toolbar title for media you sent -->
  <string name="MediaViewerScreen__you">أنت</string>
  <!-- Toolbar title for media you sent to another chat, e.g. \'You to Alice\' -->
  <string name="MediaViewerScreen__you_to_s">منك إلى %1$s</string>
  <!-- Toolbar title for media a sender sent to a group, e.g. \'Alice to Hiking Group\' -->
  <string name="MediaViewerScreen__s_to_s">%1$s إلى %2$s</string>
  <!-- Toolbar title for media a sender sent to you, e.g. \'Alice to you\' -->
  <string name="MediaViewerScreen__s_to_you">%1$s إليك</string>
  <!-- Toolbar title for media in your own note-to-self chat -->
  <string name="MediaViewerScreen__note_to_self">ملاحظات شخصية</string>
  <!-- Toolbar subtitle when previewing a draft attachment that has not been sent yet -->
  <string name="MediaViewerScreen__draft">مسوَّدة</string>
  <!-- Overflow menu item that opens the media editor -->
  <string name="MediaViewerScreen__edit">تعديل</string>
  <!-- Overflow menu item that saves the media to the device -->
  <string name="MediaViewerScreen__save">حفظ</string>
  <!-- Overflow menu item that deletes the media -->
  <string name="MediaViewerScreen__delete">حذف</string>
  <!-- Button in the note-to-self delete confirmation dialog that deletes the media -->
  <string name="MediaViewerScreen__delete_dialog_delete">حذف</string>
  <!-- Title of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_title">هل ترغبُ بحذف الرسالة؟</string>
  <!-- Body of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_message">هذا الإجراء سَيحذف الرسالة بشكلٍ دائم.</string>
  <!-- Delete dialog button that deletes the media only on this device -->
  <string name="MediaViewerScreen__delete_for_me">احذف من عندي</string>
  <!-- Delete dialog button that deletes the media for all members of the chat -->
  <string name="MediaViewerScreen__delete_for_everyone">احذف للجميع</string>
  <!-- Generic dialog cancel button -->
  <string name="MediaViewerScreen__cancel">إلغاء</string>
  <!-- Suffix appended after a truncated caption, tapped to expand it. Starts with an ellipsis marking where the caption was cut off. -->
  <string name="MediaViewerScreen__read_more">… قراءة المزيد</string>
  <!-- Title of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__cant_save_media">تعذَّر حفظ ملفات الوسائط</string>
  <!-- Body of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__media_offloaded_message">ملف الوسائط هذا لم يعد مُخزَّنًا على هذا الجهاز. يمكنك تغيير إعدادات التخزين وإعادة تنزيل ملف الوسائط هذا عبر اتصال شبكة واي فاي غير محدود.</string>
  <!-- Button on the offloaded-media dialog that opens storage settings -->
  <string name="MediaViewerScreen__view_storage_settings">عرض إعدادات التخزين</string>
  <!-- Generic dialog confirmation button -->
  <string name="MediaViewerScreen__ok">حسنًا</string>
  <!-- Content description of the toolbar back button -->
  <string name="MediaViewerScreen__navigate_back">رجوع إلى الوراء</string>
  <!-- Content description of the toolbar overflow menu button -->
  <string name="MediaViewerScreen__more_options">خيارات أكثر</string>
  <!-- Content description of the share button -->
  <string name="MediaViewerScreen__share">مشاركة</string>
  <!-- Content description of the forward button -->
  <string name="MediaViewerScreen__forward">إعادة توجيه</string>
  <!-- Content description of the video play button -->
  <string name="MediaViewerScreen__play">تشغيل</string>
  <!-- Content description of the video pause button -->
  <string name="MediaViewerScreen__pause">توقُّف مؤقَّت</string>
  <!-- Content description of the video rewind button -->
  <string name="MediaViewerScreen__rewind">إرجاع للوراء</string>
  <!-- Content description of the video fast-forward button -->
  <string name="MediaViewerScreen__fast_forward">تقديم سريع</string>
  <!-- Content description of a thumbnail in the album rail at the bottom of the screen -->
  <string name="MediaViewerScreen__album_rail_thumbnail">صورة مُصغَّرة لملف الوسائط</string>
  <!-- Time left in the playing video, shown at the end of the seek bar. %1$s is the remaining time, e.g. 0:38. The leading minus sign marks it as a countdown. -->
  <string name="MediaViewerScreen__remaining_time">−%1$s</string>
</resources>
