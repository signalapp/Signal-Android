<?xml version="1.0" encoding="UTF-8"?>
<resources>
  <!-- MediaViewerScreen -->
  <!-- Toolbar title for media you sent -->
  <string name="MediaViewerScreen__you">आप</string>
  <!-- Toolbar title for media you sent to another chat, e.g. \'You to Alice\' -->
  <string name="MediaViewerScreen__you_to_s">आपकी ओर से %1$s को</string>
  <!-- Toolbar title for media a sender sent to a group, e.g. \'Alice to Hiking Group\' -->
  <string name="MediaViewerScreen__s_to_s">%1$s की ओर से %2$s को</string>
  <!-- Toolbar title for media a sender sent to you, e.g. \'Alice to you\' -->
  <string name="MediaViewerScreen__s_to_you">%1$s से आपको</string>
  <!-- Toolbar title for media in your own note-to-self chat -->
  <string name="MediaViewerScreen__note_to_self">खुद के लिए नोट</string>
  <!-- Toolbar subtitle when previewing a draft attachment that has not been sent yet -->
  <string name="MediaViewerScreen__draft">ड्राफ़्ट</string>
  <!-- Overflow menu item that opens the media editor -->
  <string name="MediaViewerScreen__edit">एडिट करें</string>
  <!-- Overflow menu item that saves the media to the device -->
  <string name="MediaViewerScreen__save">सेव करें</string>
  <!-- Overflow menu item that deletes the media -->
  <string name="MediaViewerScreen__delete">डिलीट करें</string>
  <!-- Button in the note-to-self delete confirmation dialog that deletes the media -->
  <string name="MediaViewerScreen__delete_dialog_delete">डिलीट करें</string>
  <!-- Title of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_title">मैसेज डिलीट करना है?</string>
  <!-- Body of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_message">इससे यह मैसेज हमेशा के लिए डिलीट हो जाएगा।</string>
  <!-- Delete dialog button that deletes the media only on this device -->
  <string name="MediaViewerScreen__delete_for_me">मेरे लिए डिलीट करें</string>
  <!-- Delete dialog button that deletes the media for all members of the chat -->
  <string name="MediaViewerScreen__delete_for_everyone">सभी के लिए डिलीट करें</string>
  <!-- Generic dialog cancel button -->
  <string name="MediaViewerScreen__cancel">कैंसिल करें</string>
  <!-- Suffix appended after a truncated caption, tapped to expand it. Starts with an ellipsis marking where the caption was cut off. -->
  <string name="MediaViewerScreen__read_more">… ज़्यादा पढ़ें</string>
  <!-- Title of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__cant_save_media">मीडिया सेव नहीं हो सकता</string>
  <!-- Body of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__media_offloaded_message">यह मीडिया अब इस डिवाइस पर स्टोर नहीं है। स्टोरेज सेटिंग बदलकर, बिना किसी डेटा लिमिट वाले वाई-फ़ाई से इस मीडिया को दोबारा डाउनलोड करें।</string>
  <!-- Button on the offloaded-media dialog that opens storage settings -->
  <string name="MediaViewerScreen__view_storage_settings">स्टोरेज सेटिंग देखें</string>
  <!-- Generic dialog confirmation button -->
  <string name="MediaViewerScreen__ok">ठीक है</string>
  <!-- Content description of the toolbar back button -->
  <string name="MediaViewerScreen__navigate_back">वापस जाएं</string>
  <!-- Content description of the toolbar overflow menu button -->
  <string name="MediaViewerScreen__more_options">और विकल्प</string>
  <!-- Content description of the share button -->
  <string name="MediaViewerScreen__share">शेयर करें</string>
  <!-- Content description of the forward button -->
  <string name="MediaViewerScreen__forward">फ़ॉरवर्ड करें</string>
  <!-- Content description of the video play button -->
  <string name="MediaViewerScreen__play">चलाएं</string>
  <!-- Content description of the video pause button -->
  <string name="MediaViewerScreen__pause">पॉज़ करें</string>
  <!-- Content description of the video rewind button -->
  <string name="MediaViewerScreen__rewind">रिवाइंड करें</string>
  <!-- Content description of the video fast-forward button -->
  <string name="MediaViewerScreen__fast_forward">फ़ास्ट-फ़ॉरवर्ड करें</string>
  <!-- Content description of a thumbnail in the album rail at the bottom of the screen -->
  <string name="MediaViewerScreen__album_rail_thumbnail">मीडिया थंबनेल</string>
  <!-- Time left in the playing video, shown at the end of the seek bar. %1$s is the remaining time, e.g. 0:38. The leading minus sign marks it as a countdown. -->
  <string name="MediaViewerScreen__remaining_time">−%1$s</string>
</resources>
