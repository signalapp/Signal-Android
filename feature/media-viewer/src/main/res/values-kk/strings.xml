<?xml version="1.0" encoding="UTF-8"?>
<resources>
  <!-- MediaViewerScreen -->
  <!-- Toolbar title for media you sent -->
  <string name="MediaViewerScreen__you">Сіз</string>
  <!-- Toolbar title for media you sent to another chat, e.g. \'You to Alice\' -->
  <string name="MediaViewerScreen__you_to_s">Сіз – %1$s</string>
  <!-- Toolbar title for media a sender sent to a group, e.g. \'Alice to Hiking Group\' -->
  <string name="MediaViewerScreen__s_to_s">%1$s – %2$s</string>
  <!-- Toolbar title for media a sender sent to you, e.g. \'Alice to you\' -->
  <string name="MediaViewerScreen__s_to_you">%1$s – сіз</string>
  <!-- Toolbar title for media in your own note-to-self chat -->
  <string name="MediaViewerScreen__note_to_self">Өзіне ескертпе</string>
  <!-- Toolbar subtitle when previewing a draft attachment that has not been sent yet -->
  <string name="MediaViewerScreen__draft">Нобай</string>
  <!-- Overflow menu item that opens the media editor -->
  <string name="MediaViewerScreen__edit">Өзгерту</string>
  <!-- Overflow menu item that saves the media to the device -->
  <string name="MediaViewerScreen__save">Сақтау</string>
  <!-- Overflow menu item that deletes the media -->
  <string name="MediaViewerScreen__delete">Жою</string>
  <!-- Button in the note-to-self delete confirmation dialog that deletes the media -->
  <string name="MediaViewerScreen__delete_dialog_delete">Жою</string>
  <!-- Title of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_title">Хатты жою керек пе?</string>
  <!-- Body of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_message">Бұл функция хатты біржола жойып тастайды.</string>
  <!-- Delete dialog button that deletes the media only on this device -->
  <string name="MediaViewerScreen__delete_for_me">Меннен ғана жою</string>
  <!-- Delete dialog button that deletes the media for all members of the chat -->
  <string name="MediaViewerScreen__delete_for_everyone">Барлығынан жою</string>
  <!-- Generic dialog cancel button -->
  <string name="MediaViewerScreen__cancel">Бас тарту</string>
  <!-- Suffix appended after a truncated caption, tapped to expand it. Starts with an ellipsis marking where the caption was cut off. -->
  <string name="MediaViewerScreen__read_more">… Толық ақпарат</string>
  <!-- Title of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__cant_save_media">Мультимедианы сақтау мүмкін емес</string>
  <!-- Body of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__media_offloaded_message">Бұл мультимедиа енді осы құрылғыда сақталмайды. Жад параметрлерін өзгертіп, бұл мультимедианы Wi-Fi байланысы арқылы қайта жүктеп алуға болады.</string>
  <!-- Button on the offloaded-media dialog that opens storage settings -->
  <string name="MediaViewerScreen__view_storage_settings">Жад параметрлерін көру</string>
  <!-- Generic dialog confirmation button -->
  <string name="MediaViewerScreen__ok">OK</string>
  <!-- Content description of the toolbar back button -->
  <string name="MediaViewerScreen__navigate_back">Артқа</string>
  <!-- Content description of the toolbar overflow menu button -->
  <string name="MediaViewerScreen__more_options">Қосымша опциялар</string>
  <!-- Content description of the share button -->
  <string name="MediaViewerScreen__share">Бөлісу</string>
  <!-- Content description of the forward button -->
  <string name="MediaViewerScreen__forward">Алға</string>
  <!-- Content description of the video play button -->
  <string name="MediaViewerScreen__play">Ойнату</string>
  <!-- Content description of the video pause button -->
  <string name="MediaViewerScreen__pause">Кідіріс</string>
  <!-- Content description of the video rewind button -->
  <string name="MediaViewerScreen__rewind">Кері айналдыру</string>
  <!-- Content description of the video fast-forward button -->
  <string name="MediaViewerScreen__fast_forward">Алға айналдыру</string>
  <!-- Content description of a thumbnail in the album rail at the bottom of the screen -->
  <string name="MediaViewerScreen__album_rail_thumbnail">Мультимедиа нобайы</string>
  <!-- Time left in the playing video, shown at the end of the seek bar. %1$s is the remaining time, e.g. 0:38. The leading minus sign marks it as a countdown. -->
  <string name="MediaViewerScreen__remaining_time">−%1$s</string>
</resources>
