<?xml version="1.0" encoding="UTF-8"?>
<resources>
  <!-- MediaViewerScreen -->
  <!-- Toolbar title for media you sent -->
  <string name="MediaViewerScreen__you">Vi</string>
  <!-- Toolbar title for media you sent to another chat, e.g. \'You to Alice\' -->
  <string name="MediaViewerScreen__you_to_s">Poslano korisniku %1$s</string>
  <!-- Toolbar title for media a sender sent to a group, e.g. \'Alice to Hiking Group\' -->
  <string name="MediaViewerScreen__s_to_s">%1$s za %2$s</string>
  <!-- Toolbar title for media a sender sent to you, e.g. \'Alice to you\' -->
  <string name="MediaViewerScreen__s_to_you">Poslao korisnik %1$s</string>
  <!-- Toolbar title for media in your own note-to-self chat -->
  <string name="MediaViewerScreen__note_to_self">Osobna bilješka</string>
  <!-- Toolbar subtitle when previewing a draft attachment that has not been sent yet -->
  <string name="MediaViewerScreen__draft">Skica</string>
  <!-- Overflow menu item that opens the media editor -->
  <string name="MediaViewerScreen__edit">Uredi</string>
  <!-- Overflow menu item that saves the media to the device -->
  <string name="MediaViewerScreen__save">Spremi</string>
  <!-- Overflow menu item that deletes the media -->
  <string name="MediaViewerScreen__delete">Izbriši</string>
  <!-- Button in the note-to-self delete confirmation dialog that deletes the media -->
  <string name="MediaViewerScreen__delete_dialog_delete">Izbriši</string>
  <!-- Title of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_title">Izbriši poruku?</string>
  <!-- Body of the dialog confirming deletion of a media message -->
  <string name="MediaViewerScreen__media_delete_confirmation_message">To će trajno izbrisati ovu poruku.</string>
  <!-- Delete dialog button that deletes the media only on this device -->
  <string name="MediaViewerScreen__delete_for_me">Izbriši za mene</string>
  <!-- Delete dialog button that deletes the media for all members of the chat -->
  <string name="MediaViewerScreen__delete_for_everyone">Izbriši za sve</string>
  <!-- Generic dialog cancel button -->
  <string name="MediaViewerScreen__cancel">Poništi</string>
  <!-- Suffix appended after a truncated caption, tapped to expand it. Starts with an ellipsis marking where the caption was cut off. -->
  <string name="MediaViewerScreen__read_more">… Pročitaj više</string>
  <!-- Title of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__cant_save_media">Nije moguće spremiti medijske zapise</string>
  <!-- Body of the dialog shown when media cannot be saved because it is not on this device -->
  <string name="MediaViewerScreen__media_offloaded_message">Ovaj medijski zapis se više ne nalazi na ovom uređaju. Možete promijeniti postavke pohrane i ponovno preuzeti ovaj medijski zapis putem Wi-Fi veze koja ne troši podatkovni promet.</string>
  <!-- Button on the offloaded-media dialog that opens storage settings -->
  <string name="MediaViewerScreen__view_storage_settings">Otvori postavke pohrane</string>
  <!-- Generic dialog confirmation button -->
  <string name="MediaViewerScreen__ok">U redu</string>
  <!-- Content description of the toolbar back button -->
  <string name="MediaViewerScreen__navigate_back">Vrati se natrag</string>
  <!-- Content description of the toolbar overflow menu button -->
  <string name="MediaViewerScreen__more_options">Više opcija</string>
  <!-- Content description of the share button -->
  <string name="MediaViewerScreen__share">Podijeli</string>
  <!-- Content description of the forward button -->
  <string name="MediaViewerScreen__forward">Proslijedi</string>
  <!-- Content description of the video play button -->
  <string name="MediaViewerScreen__play">Reprodukcija</string>
  <!-- Content description of the video pause button -->
  <string name="MediaViewerScreen__pause">Zaustavi</string>
  <!-- Content description of the video rewind button -->
  <string name="MediaViewerScreen__rewind">Premotaj unatrag</string>
  <!-- Content description of the video fast-forward button -->
  <string name="MediaViewerScreen__fast_forward">Premotaj unaprijed</string>
  <!-- Content description of a thumbnail in the album rail at the bottom of the screen -->
  <string name="MediaViewerScreen__album_rail_thumbnail">Sličica medijskog zapisa</string>
  <!-- Time left in the playing video, shown at the end of the seek bar. %1$s is the remaining time, e.g. 0:38. The leading minus sign marks it as a countdown. -->
  <string name="MediaViewerScreen__remaining_time">−%1$s</string>
</resources>
