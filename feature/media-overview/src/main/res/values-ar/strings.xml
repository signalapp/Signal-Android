    </plurals>
  <!-- Body of the dialog confirming deletion of the selected media overview items. The placeholder is the number of selected items -->
  <plurals name="MediaOverviewScreen__delete_confirm_message">
        <item quantity="zero">هذا سيحذف جميع الـ %1$d ملف التي تمّ اختياره. سيتم حذف أيضًا أي رسالة نصية ذات صلة بهذه العناصر.</item>
        <item quantity="one">هذا سيحذف الملف الذي تمّ اختياره. سيتم حذف أيضًا أي رسالة نصية ذات صلة بهذه العناصر.</item>
        <item quantity="two">هذا سيحذف الملفين اللذين تمّ اختيارهما. سيتم حذف أيضًا أي رسالة نصية ذات صلة بهذه العناصر.</item>
        <item quantity="few">هذا سيحذف جميع الـ %1$d ملفات التي تمّ اختيارها. سيتم حذف أيضًا أي رسالة نصية ذات صلة بهذه العناصر.</item>
        <item quantity="many">هذا سيحذف جميع الـ %1$d ملفًا التي تمّ اختيارها. سيتم حذف أيضًا أي رسالة نصية ذات صلة بهذه العناصر.</item>
        <item quantity="other">هذا سيحذف جميع الـ %1$d ملف التي تمّ اختيارها. سيتم حذف أيضًا أي رسالة نصية ذات صلة بهذه العناصر.</item>
    </plurals>
  <!-- Title of the progress dialog shown while the selected media overview items are being deleted -->
  <string name="MediaOverviewScreen__deleting">جارٍ الحذف</string>
  <!-- Progress shown below the title while deleting media overview items. The first placeholder is how many are done, the second is the total (e.g. "12 of 207") -->
  <string name="MediaOverviewScreen__delete_progress_count">%1$d من %2$d</string>

  <!-- Title of the dialog shown when saving from the media overview, and every selected item has been removed from the device to save space -->
  <string name="MediaOverviewScreen__cant_save_media">تعذَّر حفظ ملفات الوسائط</string>
  <!-- Body of the dialog shown when saving from the media overview, and every selected item has been removed from the device to save space. "Optimize Signal storage" is the name of a setting -->
  <string name="MediaOverviewScreen__media_offloaded_message">تمَّ نقل ملفات الوسائط هذه من جهازك لأن خاصية \"تحسين التخزين على سيجنال\" مُفعَّلة. يُمكنك تنزيل العناصر واحدًا تلو الآخر، أو إيقاف تشغيل خاصية \"تحسين التخزين على سيجنال\" لتنزيل جميع الوسائط إلى جهازك.</string>
  <!-- Title of the dialog shown when saving from the media overview, and some of the selected items have been removed from the device to save space -->
  <string name="MediaOverviewScreen__cant_save_all_items">تعذَّر حفظ جميع العناصر</string>
  <!-- Body of the dialog shown when saving from the media overview, and some of the selected items have been removed from the device to save space. "Optimize Signal storage" is the name of a setting -->
  <string name="MediaOverviewScreen__some_media_offloaded_message">تمَّ نقل بعض ملفات الوسائط التي اخترتها من جهازك لأن خاصية \"تحسين التخزين على سيجنال\" مُفعَّلة. يمكنك حفظ العناصر واحدًا تلو الآخر، أو إيقاف تشغيل خاصية \"تحسين التخزين على سيجنال\" لتنزيل جميع ملفات الوسائط إلى جهازك.</string>
  <!-- Button in the dialogs about media removed from the device to save space. Opens the storage settings screen -->
  <string name="MediaOverviewScreen__view_storage_settings">عرض إعدادات التخزين</string>
  <!-- Toast shown when tapping a photo or video in the media overview that is still being sent -->
  <string name="MediaOverviewScreen__media_not_sent_yet">لم يتم إرسال ملف الوسائط بعد.</string>

