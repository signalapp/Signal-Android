  <!-- Title of the dialog confirming deletion of the selected media overview items -->
  <plurals name="MediaOverviewScreen__delete_confirm_title">
        <item quantity="one">ਕੀ ਚੁਣੀ ਗਈ ਆਈਟਮ ਨੂੰ ਮਿਟਾਉਣਾ ਹੈ?</item>
        <item quantity="other">ਕੀ ਚੁਣੀਆਂ ਗਈਆਂ ਆਈਟਮਾਂ ਨੂੰ ਮਿਟਾਉਣਾ ਹੈ?</item>
    </plurals>
  <!-- Body of the dialog confirming deletion of the selected media overview items. The placeholder is the number of selected items -->
  <plurals name="MediaOverviewScreen__delete_confirm_message">
        <item quantity="one">ਅਜਿਹਾ ਕਰਨ \'ਤੇ ਚੁਣੀ ਗਈ ਫ਼ਾਈਲ ਨੂੰ ਸਥਾਈ ਤੌਰ ’ਤੇ ਮਿਟਾ ਦਿੱਤਾ ਜਾਵੇਗਾ। ਇਸ ਆਈਟਮ ਨਾਲ ਜੁੜੇ ਟੈਕਸਟ ਸੁਨੇਹੇ ਵੀ ਮਿਟਾ ਦਿੱਤੇ ਜਾਣਗੇ।</item>
        <item quantity="other">ਅਜਿਹਾ ਕਰਨ \'ਤੇ ਚੁਣੀਆਂ ਗਈਆਂ %1$d ਫ਼ਾਈਲਾਂ ਨੂੰ ਸਥਾਈ ਤੌਰ ’ਤੇ ਮਿਟਾ ਦਿੱਤਾ ਜਾਵੇਗਾ। ਇਹਨਾਂ ਆਈਟਮਾਂ ਨਾਲ ਜੁੜੇ ਟੈਕਸਟ ਸੁਨੇਹੇ ਵੀ ਮਿਟਾ ਦਿੱਤੇ ਜਾਣਗੇ।</item>
    </plurals>
  <!-- Title of the progress dialog shown while the selected media overview items are being deleted -->
  <string name="MediaOverviewScreen__deleting">ਹਟਾਇਆ ਜਾ ਰਿਹਾ ਹੈ</string>
  <!-- Progress shown below the title while deleting media overview items. The first placeholder is how many are done, the second is the total (e.g. "12 of 207") -->
  <string name="MediaOverviewScreen__delete_progress_count">%2$d ਵਿੱਚੋਂ %1$d</string>

  <!-- Title of the dialog shown when saving from the media overview, and every selected item has been removed from the device to save space -->
  <string name="MediaOverviewScreen__cant_save_media">ਮੀਡੀਆ ਸੇਵ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ</string>
  <!-- Body of the dialog shown when saving from the media overview, and every selected item has been removed from the device to save space. "Optimize Signal storage" is the name of a setting -->
  <string name="MediaOverviewScreen__media_offloaded_message">ਇਹ ਮੀਡੀਆ ਤੁਹਾਡੇ ਡਿਵਾਈਸ ਤੋਂ ਆਫਲੋਡ ਕਰ ਦਿੱਤਾ ਗਿਆ ਹੈ ਕਿਉਂਕਿ \"Signal ਸਟੋਰੇਜ ਨੂੰ ਅਨੁਕੂਲ ਬਣਾਓ\" ਸੈਟਿੰਗ ਚਾਲੂ ਹੈ। ਤੁਸੀਂ ਆਈਟਮਾਂ ਨੂੰ ਇੱਕ-ਇੱਕ ਕਰਕੇ ਡਾਊਨਲੋਡ ਕਰ ਸਕਦੇ ਹੋ, ਜਾਂ ਸਾਰਾ ਮੀਡੀਆ ਆਪਣੇ ਡਿਵਾਈਸ \'ਤੇ ਡਾਊਨਲੋਡ ਕਰਨ ਲਈ \"Signal ਸਟੋਰੇਜ ਨੂੰ ਅਨੁਕੂਲ ਬਣਾਓ\" ਸੈਟਿੰਗ ਨੂੰ ਬੰਦ ਕਰ ਸਕਦੇ ਹੋ।</string>
  <!-- Title of the dialog shown when saving from the media overview, and some of the selected items have been removed from the device to save space -->
  <string name="MediaOverviewScreen__cant_save_all_items">ਸਾਰੀਆਂ ਆਈਟਮਾਂ ਨੂੰ ਸੇਵ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ</string>
  <!-- Body of the dialog shown when saving from the media overview, and some of the selected items have been removed from the device to save space. "Optimize Signal storage" is the name of a setting -->
  <string name="MediaOverviewScreen__some_media_offloaded_message">ਤੁਹਾਡੇ ਵੱਲੋਂ ਚੁਣਿਆ ਗਿਆ ਕੁਝ ਮੀਡੀਆ ਤੁਹਾਡੇ ਡਿਵਾਈਸ ਤੋਂ ਆਫਲੋਡ ਕਰ ਦਿੱਤਾ ਗਿਆ ਹੈ ਕਿਉਂਕਿ \"Signal ਸਟੋਰੇਜ ਨੂੰ ਅਨੁਕੂਲ ਬਣਾਓ\" ਸੈਟਿੰਗ ਚਾਲੂ ਹੈ। ਤੁਸੀਂ ਆਈਟਮਾਂ ਨੂੰ ਇੱਕ-ਇੱਕ ਕਰਕੇ ਸੇਵ ਕਰ ਸਕਦੇ ਹੋ, ਜਾਂ ਸਾਰਾ ਮੀਡੀਆ ਆਪਣੇ ਡਿਵਾਈਸ \'ਤੇ ਡਾਊਨਲੋਡ ਕਰਨ ਲਈ \"Signal ਸਟੋਰੇਜ ਨੂੰ ਅਨੁਕੂਲ ਬਣਾਓ\" ਸੈਟਿੰਗ ਨੂੰ ਬੰਦ ਕਰ ਸਕਦੇ ਹੋ।</string>
  <!-- Button in the dialogs about media removed from the device to save space. Opens the storage settings screen -->
  <string name="MediaOverviewScreen__view_storage_settings">ਸਟੋਰੇਜ ਦੀਆਂ ਸੈਟਿੰਗਾਂ ਦੇਖੋ</string>
  <!-- Toast shown when tapping a photo or video in the media overview that is still being sent -->
