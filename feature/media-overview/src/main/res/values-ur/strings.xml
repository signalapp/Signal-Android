  <!-- Title of the dialog confirming deletion of the selected media overview items -->
  <plurals name="MediaOverviewScreen__delete_confirm_title">
        <item quantity="one">منتخب کردہ آئٹم کو حذف کریں؟</item>
        <item quantity="other">منتخب کردہ آئٹمز کو حذف کریں؟</item>
    </plurals>
  <!-- Body of the dialog confirming deletion of the selected media overview items. The placeholder is the number of selected items -->
  <plurals name="MediaOverviewScreen__delete_confirm_message">
        <item quantity="one">یہ منتخب فائلوں کو مستقل طور پر حذف کردے گا۔ اس آئٹم سے وابستہ کوئی میسج ٹیکسٹ بھی حذف ہوجائے گا۔</item>
        <item quantity="other">یہ تمام %1$d منتخب فائلوں کو مستقل طور پر حذف کردے گا۔ ان آئٹمز سے وابستہ کوئی میجس ٹیکسٹ بھی حذف ہوجائے گا۔</item>
    </plurals>
  <!-- Title of the progress dialog shown while the selected media overview items are being deleted -->
  <string name="MediaOverviewScreen__deleting">حذف ہو رہا ہے</string>
