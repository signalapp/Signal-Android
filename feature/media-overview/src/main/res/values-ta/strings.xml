  <!-- Title of the dialog shown when saving from the media overview, and every selected item has been removed from the device to save space -->
  <string name="MediaOverviewScreen__cant_save_media">ஊடகத்தைச் சேமிக்க முடியவில்லை</string>
  <!-- Body of the dialog shown when saving from the media overview, and every selected item has been removed from the device to save space. "Optimize Signal storage" is the name of a setting -->
  <string name="MediaOverviewScreen__media_offloaded_message">\"சிக்னல் சேமிப்பகத்தை மேம்படுத்துக\" அம்சம் ஆன் செய்யப்பட்டிருப்பதால், இந்த ஊடகம் உங்கள் சிக்னல் செயலியிலிருந்து ஆஃப்லோடு செய்யப்பட்டுள்ளது. நீங்கள் உருப்படிகளை ஒவ்வொன்றாகப் பதிவிறக்கலாம் அல்லது அனைத்து ஊடகத்தையும் உங்கள் சிக்னல் செயலியில் பதிவிறக்க \"சிக்னல் சேமிப்பகத்தை மேம்படுத்துக\" என்பதை ஆஃப் செய்யலாம்.</string>
  <!-- Title of the dialog shown when saving from the media overview, and some of the selected items have been removed from the device to save space -->
  <string name="MediaOverviewScreen__cant_save_all_items">அனைத்து உருப்படிகளையும் சேமிக்க முடியவில்லை</string>
  <!-- Body of the dialog shown when saving from the media overview, and some of the selected items have been removed from the device to save space. "Optimize Signal storage" is the name of a setting -->
  <string name="MediaOverviewScreen__some_media_offloaded_message">\"சிக்னல் சேமிப்பகத்தை மேம்படுத்துக\" அம்சம் ஆன் செய்யப்பட்டிருப்பதால், நீங்கள் தேர்ந்தெடுத்த சில ஊடகங்கள் உங்கள் சிக்னல் செயலியிலிருந்து ஆஃப்லோடு செய்யப்பட்டுள்ளன. நீங்கள் உருப்படிகளை ஒவ்வொன்றாகச் சேமிக்கலாம் அல்லது அனைத்து ஊடகத்தையும் உங்கள் சிக்னல் செயலியில் பதிவிறக்க \"சிக்னல் சேமிப்பகத்தை மேம்படுத்துக\" என்பதை ஆஃப் செய்யலாம்.</string>
  <!-- Button in the dialogs about media removed from the device to save space. Opens the storage settings screen -->
  <string name="MediaOverviewScreen__view_storage_settings">சேமிப்பக அமைப்புகளைக் காண்க</string>
