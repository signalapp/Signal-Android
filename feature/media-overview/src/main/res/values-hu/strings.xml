  <string name="MediaOverviewScreen__delete_progress_count">%1$d / %2$d</string>

  <!-- Title of the dialog shown when saving from the media overview, and every selected item has been removed from the device to save space -->
  <string name="MediaOverviewScreen__cant_save_media">A médiafájl nem menthető</string>
  <!-- Body of the dialog shown when saving from the media overview, and every selected item has been removed from the device to save space. "Optimize Signal storage" is the name of a setting -->
  <string name="MediaOverviewScreen__media_offloaded_message">Ez a médiafájl áthelyezésre került az eszközödről, mert be van kapcsolva a „Signal-tárhely optimalizálása” lehetőség. Az elemeket letöltheted egyenként, vagy kikapcsolhatod a „Signal-tárhely optimalizálása” funkciót, hogy az összes médiatartalmat letöltsd az eszközödre.</string>
  <!-- Title of the dialog shown when saving from the media overview, and some of the selected items have been removed from the device to save space -->
  <string name="MediaOverviewScreen__cant_save_all_items">Nem menthető az összes elem</string>
  <!-- Body of the dialog shown when saving from the media overview, and some of the selected items have been removed from the device to save space. "Optimize Signal storage" is the name of a setting -->
  <string name="MediaOverviewScreen__some_media_offloaded_message">Néhány kiválasztott médiafájl áthelyezésre kerül az eszközödről, mert be van kapcsolva a „Signal-tárhely optimalizálása” lehetőség. Az elemeket egyesével mentheted el, vagy kikapcsolhatod a „Signal-tárhely optimalizálása” funkciót, hogy az összes médiafájlt letöltsd az eszközödre.</string>
  <!-- Button in the dialogs about media removed from the device to save space. Opens the storage settings screen -->
  <string name="MediaOverviewScreen__view_storage_settings">Tárhelybeállítások megtekintése</string>
  <!-- Toast shown when tapping a photo or video in the media overview that is still being sent -->
