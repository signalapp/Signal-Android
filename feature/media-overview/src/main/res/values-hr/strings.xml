  <!-- Removed by excludeNonTranslatables <string name="MediaOverviewScreen__three_part_line" translatable="false">%1$s · %2$s · %3$s</string> -->

  <!-- Accessibility description for a photo or video thumbnail in the media overview grid -->
  <string name="MediaOverviewScreen__media_preview">Pregled medijskog zapisa</string>
  <!-- Accessibility description for the play icon drawn over a video thumbnail in the media overview -->
  <string name="MediaOverviewScreen__play_video">Reproduciraj video</string>
  <!-- Accessibility description for the check mark shown on a selected item in the media overview -->
  <string name="MediaOverviewScreen__selected">Odabrano</string>
  <!-- Accessibility description for the button in a media overview list row that plays an audio file -->
  <string name="MediaOverviewScreen__play">Reprodukcija</string>
  <!-- Accessibility description for the button in a media overview list row that pauses an audio file that is playing -->
  <string name="MediaOverviewScreen__pause">Zaustavi</string>
  <!-- Accessibility description for the button in a media overview list row that downloads an audio file that is not on the device yet -->
  <string name="MediaOverviewScreen__download">Preuzmi</string>
</resources>
