  <!-- Title of the dialog confirming deletion of the selected media overview items -->
  <plurals name="MediaOverviewScreen__delete_confirm_title">
        <item quantity="other">ရွေးထားသည်များကို ဖျက်မည်လား။</item>
    </plurals>
  <!-- Body of the dialog confirming deletion of the selected media overview items. The placeholder is the number of selected items -->
  <plurals name="MediaOverviewScreen__delete_confirm_message">
        <item quantity="other">ရွေးထားသည့် ဖိုင် %1$d ခုကို အပြီးတိုင်ဖျက်သွားမည်။ ၎င်းအရာများနှင့် ဆက်စပ်နေသည့် စာသားမက်ဆေ့ချ်များကိုလည်း ဖျက်သွားပါမည်။</item>
    </plurals>
  <!-- Title of the progress dialog shown while the selected media overview items are being deleted -->
  <string name="MediaOverviewScreen__deleting">ဖျက်နေသည်</string>
