  <string name="MediaOverviewScreen__jump_to_message">सीधे मैसेज पर जाएं</string>

  <!-- Title of the dialog confirming deletion of the selected media overview items -->
  <plurals name="MediaOverviewScreen__delete_confirm_title">
        <item quantity="one">चयनित आइटम डिलीट करें?</item>
        <item quantity="other">चयनित आइटम डिलीट करें?</item>
    </plurals>
  <!-- Body of the dialog confirming deletion of the selected media overview items. The placeholder is the number of selected items -->
  <plurals name="MediaOverviewScreen__delete_confirm_message">
        <item quantity="one">इससे चुनी गई फ़ाइल हमेशा के लिए डिलीट हो जाएंगी। इन आइटम से जुड़े सभी मैसेज भी डिलीट हो जाएंगे।</item>
        <item quantity="other">इससे चुनी गई सभी %1$d फ़ाइल हमेशा के लिए डिलीट हो जाएंगी। इन आइटम से जुड़े सभी मैसेज भी डिलीट हो जाएंगे।</item>
    </plurals>
  <!-- Title of the progress dialog shown while the selected media overview items are being deleted -->
  <string name="MediaOverviewScreen__deleting">डिलीट किया जा रहा है</string>
  <!-- Progress shown below the title while deleting media overview items. The first placeholder is how many are done, the second is the total (e.g. "12 of 207") -->
  <string name="MediaOverviewScreen__delete_progress_count">%1$d में से %2$d</string>

  <!-- Title of the dialog shown when saving from the media overview, and every selected item has been removed from the device to save space -->
  <string name="MediaOverviewScreen__cant_save_media">मीडिया सेव नहीं हो सकता</string>
  <!-- Body of the dialog shown when saving from the media overview, and every selected item has been removed from the device to save space. "Optimize Signal storage" is the name of a setting -->
  <string name="MediaOverviewScreen__media_offloaded_message">यह मीडिया आपके डिवाइस से ऑफ़लोड किया जा चुका है। ऐसा इसलिए हुआ, क्योंकि \'Signal स्टोरेज को ऑप्टिमाइज़ करें\' फ़ीचर चालू है। हालांकि, आइटम एक-एक करके डाउनलोड किए जा सकते हैं या \'Signal स्टोरेज को ऑप्टिमाइज़ करें\' फ़ीचर बंद करके अपने डिवाइस पर सारा मीडिया डाउनलोड किया जा सकता है।</string>
  <!-- Title of the dialog shown when saving from the media overview, and some of the selected items have been removed from the device to save space -->
  <string name="MediaOverviewScreen__cant_save_all_items">सभी आइटम सेव नहीं किए जा सकते</string>
  <!-- Body of the dialog shown when saving from the media overview, and some of the selected items have been removed from the device to save space. "Optimize Signal storage" is the name of a setting -->
  <string name="MediaOverviewScreen__some_media_offloaded_message">आपने जो मीडिया चुना है उसमें से कुछ मीडिया फ़ाइलें आपके डिवाइस से ऑफ़लोड की जा चुकी हैं, क्योंकि \'Signal स्टोरेज को ऑप्टिमाइज़ करें\' फ़ीचर चालू है। हालांकि, आइटम एक-एक करके सेव किए जा सकते हैं या \'Signal स्टोरेज को ऑप्टिमाइज़ करें\' फ़ीचर बंद करके अपने डिवाइस पर सारा मीडिया डाउनलोड किया जा सकता है।</string>
  <!-- Button in the dialogs about media removed from the device to save space. Opens the storage settings screen -->
  <string name="MediaOverviewScreen__view_storage_settings">स्टोरेज सेटिंग देखें</string>
  <!-- Toast shown when tapping a photo or video in the media overview that is still being sent -->
  <string name="MediaOverviewScreen__media_not_sent_yet">यह मीडिया अभी तक भेजा नहीं गया।</string>

