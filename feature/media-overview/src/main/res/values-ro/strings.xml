<?xml version="1.0" encoding="UTF-8"?>
<resources>
  <!-- Section header in the media overview list, above items sent or received today -->
  <string name="MediaOverviewScreen__today">Azi</string>
  <!-- Section header in the media overview list, above items sent or received yesterday -->
  <string name="MediaOverviewScreen__yesterday">Ieri</string>
  <!-- Section header in the media overview list, above items sent or received earlier this week -->
  <string name="MediaOverviewScreen__this_week">Săptămâna aceasta</string>
  <!-- Section header in the media overview list, above items sent or received earlier this month -->
  <string name="MediaOverviewScreen__this_month">Luna aceasta</string>
  <!-- Section header in the media overview list when sorted by storage used, above the largest files -->
  <string name="MediaOverviewScreen__large">Mare</string>
  <!-- Section header in the media overview list when sorted by storage used, above medium-sized files -->
  <string name="MediaOverviewScreen__medium">Mediu</string>
  <!-- Section header in the media overview list when sorted by storage used, above the smallest files -->
  <string name="MediaOverviewScreen__small">Mic</string>

  <!-- Tab title in the media overview screen for photos and videos -->
  <string name="MediaOverviewScreen__tab_media">Media</string>
  <!-- Tab title in the media overview screen for documents and other files -->
  <string name="MediaOverviewScreen__tab_files">Fișiere</string>
  <!-- Tab title in the media overview screen for voice messages and audio files -->
  <string name="MediaOverviewScreen__tab_audio">Audio</string>
  <!-- Tab title in the media overview screen for links sent in the chat -->
  <string name="MediaOverviewScreen__tab_links">Link-uri</string>
  <!-- Tab title in the media overview screen showing every kind of item together -->
  <string name="MediaOverviewScreen__tab_all">Toate</string>

  <!-- Screen title when the media overview shows media from every chat, so the user can review what is using storage -->
  <string name="MediaOverviewScreen__all_storage_use">Toată utilizarea stocării</string>
  <!-- Screen title while selecting items in the media overview. The first placeholder is the number of selected items, the second is their combined file size (e.g. "3 selected (12 MB)") -->
  <plurals name="MediaOverviewScreen__d_selected_s">
        <item quantity="one">%1$d selectat (%2$s)</item>
        <item quantity="few">%1$d selectate (%2$s)</item>
        <item quantity="other">%1$d selectate (%2$s)</item>
    </plurals>
  <!-- Shown in the middle of a media overview tab that has nothing in it -->
  <string name="MediaOverviewScreen__no_media">Nu ai fișiere media</string>

  <!-- Title of the dialog for choosing how the media overview is sorted -->
  <string name="MediaOverviewScreen__sort_by">Sortează după</string>
  <!-- Sort option in the media overview, and the label of the sort button when selected. Shows the most recent items first -->
  <string name="MediaOverviewScreen__newest">Noi</string>
  <!-- Sort option in the media overview, and the label of the sort button when selected. Shows the earliest items first -->
  <string name="MediaOverviewScreen__oldest">Vechi</string>
  <!-- Sort option in the media overview, and the label of the sort button when selected. Shows the largest files first -->
  <string name="MediaOverviewScreen__storage_used">Utilizare spațiu stocare</string>
  <!-- Accessibility description for the button that switches the media overview from a list back to a grid of thumbnails -->
  <string name="MediaOverviewScreen__grid_view">Vizualizare grilă</string>
  <!-- Accessibility description for the button that switches the media overview from a grid of thumbnails to a list with file details -->
  <string name="MediaOverviewScreen__list_view">Vizualizare listă</string>

  <!-- Bottom bar button that saves the selected media to the device. Plural so the verb can agree with the number of selected items -->
  <plurals name="MediaOverviewScreen__save_plural">
        <item quantity="one">Salvează</item>
        <item quantity="few">Salvează</item>
        <item quantity="other">Salvează</item>
    </plurals>
  <!-- Bottom bar button that selects every item in the current media overview tab -->
  <string name="MediaOverviewScreen__select_all">Selectează tot</string>
  <!-- Bottom bar button that deletes the selected media. Plural so the verb can agree with the number of selected items -->
  <plurals name="MediaOverviewScreen__delete_plural">
        <item quantity="one">Șterge</item>
        <item quantity="few">Șterge</item>
        <item quantity="other">Șterge</item>
    </plurals>

  <!-- Menu item shown when long-pressing an item in the media overview. Opens a sheet to forward the item to other chats -->
  <string name="MediaOverviewScreen__forward">Redirecționează</string>
  <!-- Menu item shown when long-pressing an item in the media overview. Shares the item with another app -->
  <string name="MediaOverviewScreen__share">Distribuie</string>
  <!-- Menu item shown when long-pressing an item in the media overview. Saves the item to the device -->
  <string name="MediaOverviewScreen__save">Salvează</string>
  <!-- Menu item shown when long-pressing an item in the media overview, and the confirm button of the dialog asking whether to delete the selected items -->
  <string name="MediaOverviewScreen__delete">Șterge</string>
  <!-- Menu item shown when long-pressing an item in the media overview. Starts selecting multiple items, beginning with this one -->
  <string name="MediaOverviewScreen__select">Selectează</string>
  <!-- Menu item shown when long-pressing an item in the media overview. Opens the chat scrolled to the message the item was sent in -->
  <string name="MediaOverviewScreen__jump_to_message">Sari la mesaj</string>

  <!-- Title of the dialog confirming deletion of the selected media overview items -->
  <plurals name="MediaOverviewScreen__delete_confirm_title">
        <item quantity="one">Ștergi elementul selectat?</item>
        <item quantity="few">Ștergi elementele selectate?</item>
        <item quantity="other">Ștergi elementele selectate?</item>
    </plurals>
  <!-- Body of the dialog confirming deletion of the selected media overview items. The placeholder is the number of selected items -->
  <plurals name="MediaOverviewScreen__delete_confirm_message">
        <item quantity="one">Această acțiune va șterge permanent fișierul selectat. Orice mesaj text asociat cu acest element va fi de asemenea șters.</item>
        <item quantity="few">Această acțiune va șterge permanent toate cele %1$d fișiere selectate. Orice mesaj text asociat cu aceste elemente va fi de asemenea șters.</item>
        <item quantity="other">Această acțiune va șterge permanent toate cele %1$d de fișiere selectate. Orice mesaj text asociat cu aceste elemente va fi de asemenea șters.</item>
    </plurals>
  <!-- Title of the progress dialog shown while the selected media overview items are being deleted -->
  <string name="MediaOverviewScreen__deleting">Se șterge</string>
  <!-- Progress shown below the title while deleting media overview items. The first placeholder is how many are done, the second is the total (e.g. "12 of 207") -->
  <string name="MediaOverviewScreen__delete_progress_count">%1$d din %2$d</string>

  <!-- Title of the dialog shown when saving from the media overview, and every selected item has been removed from the device to save space -->
  <string name="MediaOverviewScreen__cant_save_media">Nu se pot salva fișierele media</string>
  <!-- Body of the dialog shown when saving from the media overview, and every selected item has been removed from the device to save space. "Optimize Signal storage" is the name of a setting -->
  <string name="MediaOverviewScreen__media_offloaded_message">Acest fișier media a fost eliminat de pe dispozitiv pentru că este activată funcția Optimizează stocarea Signal. Poți să descarci articolele unul câte unul sau să dezactivezi Optimizează stocarea Signal ca să descarci toate fișierele pe dispozitiv.</string>
  <!-- Title of the dialog shown when saving from the media overview, and some of the selected items have been removed from the device to save space -->
  <string name="MediaOverviewScreen__cant_save_all_items">Nu se pot salva toate articolele</string>
  <!-- Body of the dialog shown when saving from the media overview, and some of the selected items have been removed from the device to save space. "Optimize Signal storage" is the name of a setting -->
  <string name="MediaOverviewScreen__some_media_offloaded_message">Unele fișiere pe care le-ai selectat au eliminate de pe dispozitiv deoarece este pornită funcția Optimizează stocarea Signal. Poți să salvezi articolele unul câte unul sau să dezactivezi Optimizează stocarea Signal ca să-ți descarci toate fișierele pe dispozitiv.</string>
  <!-- Button in the dialogs about media removed from the device to save space. Opens the storage settings screen -->
  <string name="MediaOverviewScreen__view_storage_settings">Vezi setările de stocare</string>
  <!-- Toast shown when tapping a photo or video in the media overview that is still being sent -->
  <string name="MediaOverviewScreen__media_not_sent_yet">Fișierul nu este încă trimis.</string>

  <!-- File type shown in a media overview list row, between the file size and the date (e.g. "2 MB · Image · Nov 3") -->
  <string name="MediaOverviewScreen__type_image">Imagine</string>
  <!-- File type shown in a media overview list row, between the file size and the date (e.g. "2 MB · Video · Nov 3") -->
  <string name="MediaOverviewScreen__type_video">Video</string>
  <!-- File type shown in a media overview list row, between the file size and the date (e.g. "2 MB · Audio · Nov 3") -->
  <string name="MediaOverviewScreen__type_audio">Audio</string>
  <!-- File type shown in a media overview list row, between the file size and the date, for documents and other files (e.g. "2 MB · File · Nov 3") -->
  <string name="MediaOverviewScreen__type_file">Fișier</string>
  <!-- Title of a voice message in a media overview list row, in place of a file name -->
  <string name="MediaOverviewScreen__voice_message">Mesaj vocal</string>
  <!-- Shown in a media overview list row for an item in the user\'s Note to Self chat, in place of who sent it -->
  <string name="MediaOverviewScreen__note_to_self">Notă Personală</string>
  <!-- Shown in a media overview list row for an item someone else sent. The placeholder is the sender\'s name -->
  <string name="MediaOverviewScreen__sent_by_s">Trimis de %1$s</string>
  <!-- Shown in a media overview list row for an item the user sent -->
  <string name="MediaOverviewScreen__sent_by_you">Trimis de tine</string>
  <!-- Shown in a media overview list row when listing media from every chat, for an item someone else sent in a group. The first placeholder is the sender\'s name, the second is the group name -->
  <string name="MediaOverviewScreen__sent_by_s_to_s">Trimis de %1$s către %2$s</string>
  <!-- Shown in a media overview list row when listing media from every chat, for an item the user sent. The placeholder is the name of the chat it was sent to -->
  <string name="MediaOverviewScreen__sent_by_you_to_s">Trimis de tine către %1$s</string>
