<resources>
  <!-- Tab labels -->
  <!-- Label of the tab that shows the emoji page of the media keyboard. Noun. -->
  <string name="MediaKeyboard__emoji">រូបតំណាងអារម្មណ៍</string>
  <!-- Label of the tab that shows the sticker page of the media keyboard. Plural noun. -->
  <string name="MediaKeyboard__stickers">ស្ទីកគ័រ</string>
  <!-- Label of the tab that shows the GIF page of the media keyboard. Plural noun. -->
  <string name="MediaKeyboard__gifs">GIFs</string>

  <!-- Search -->
  <!-- Placeholder text in the media keyboard search field while the emoji tab is showing. -->
  <string name="MediaKeyboard__search_emoji">ស្វែងរករូបតំណាងអារម្មណ៍</string>
  <!-- Placeholder text in the search field at the top of the sticker page, and in the media keyboard search field while the sticker tab is showing. -->
  <string name="MediaKeyboard__search_stickers">ស្វែងរកស្ទីកក័រ</string>
  <!-- Placeholder text in the search field at the top of the GIF page, and in the media keyboard search field while the GIF tab is showing. -->
  <string name="MediaKeyboard__search_gifs">ស្វែករក GIFs</string>
  <!-- Accessibility description for the magnifying glass button in the media keyboard top bar that opens search. Verb, as an action the button performs. -->
  <string name="MediaKeyboard__search">ស្វែងរក</string>
  <!-- Accessibility description for the back button that closes media keyboard search and returns to the tabs. -->
  <string name="MediaKeyboard__close_search">បិទការស្វែងរក</string>
  <!-- Accessibility description for the button that erases whatever has been typed into the media keyboard search field. -->
  <string name="MediaKeyboard__clear_search">លុបការស្វែងរក</string>
  <!-- Message shown in place of the grid when a media keyboard search matches no emoji or GIFs. -->
  <string name="MediaKeyboard__no_results_found">រកមិនឃើញលទ្ធផល</string>

  <!-- Emoji page -->
  <!-- Accessibility description for the button in the media keyboard top bar that deletes the character before the cursor. Verb, as an action the button performs. -->
  <string name="MediaKeyboard__backspace">ផ្នែកខាងក្រោយ</string>
  <!-- Header, and rail accessibility description, for the group of emoji or stickers the user picked most recently. -->
  <string name="MediaKeyboard__recently_used">ទើបតែប្រើថ្មីៗ</string>
  <!-- Header for the emoji category holding faces and people. -->
  <string name="MediaKeyboard__smileys_and_people">រូបញញឹម និងមនុស្ស</string>
  <!-- Header for the emoji category holding animals and plants. -->
  <string name="MediaKeyboard__nature">ធម្មជាតិ</string>
  <!-- Header for the emoji category holding food and drink. -->
  <string name="MediaKeyboard__food">អាហារ</string>
  <!-- Header for the emoji category holding sports and hobbies. -->
  <string name="MediaKeyboard__activities">សកម្មភាព</string>
  <!-- Header for the emoji category holding travel, buildings and places. -->
  <string name="MediaKeyboard__places">ទីកន្លែង</string>
  <!-- Header for the emoji category holding everyday objects. -->
  <string name="MediaKeyboard__objects">វត្ថុ</string>
  <!-- Header for the emoji category holding symbols and signs. -->
  <string name="MediaKeyboard__symbols">សញ្ញា</string>
  <!-- Header for the emoji category holding country and region flags. Plural noun, the flags themselves. -->
  <string name="MediaKeyboard__flags">ទង់</string>
  <!-- Header for the emoji category holding text emoticons such as :-) -->
  <string name="MediaKeyboard__emoticons">រូបតំណាងអារម្មណ៍</string>

  <!-- Sticker page -->
  <!-- Accessibility description for the button in the media keyboard top bar that opens the screen where sticker packs are managed. -->
  <string name="MediaKeyboard__manage_stickers">Manage stickers</string>
  <!-- Menu option that sends a sticker, on a long-pressed sticker, or the whole pack as a link, in a sticker pack header\'s menu. Verb, imperative. -->
  <string name="MediaKeyboard__send">ផ្ញើ</string>
  <!-- Menu option, on a long-pressed sticker and in a sticker pack header\'s menu, that opens the pack the sticker belongs to. Verb phrase, imperative. -->
  <string name="MediaKeyboard__view_pack">មើលកញ្ចប់</string>
  <!-- Accessibility description for the three-dot button at the end of a sticker pack header, which opens that pack\'s menu. -->
  <string name="MediaKeyboard__more_options">ជម្រើសច្រើនទៀត</string>
  <!-- Menu option in a sticker pack header\'s menu that uninstalls the pack. Verb, imperative. -->
  <string name="MediaKeyboard__remove_pack">លុបចេញ</string>
  <!-- Title of the confirmation dialog shown before uninstalling a sticker pack. -->
  <string name="MediaKeyboard__remove_sticker_pack_question">Remove sticker pack?</string>
  <!-- Body of the confirmation dialog shown before uninstalling a sticker pack. -->
  <string name="MediaKeyboard__this_will_remove_the_sticker_pack">This will remove the sticker pack. You can\'t add it again without a link or sticker message.</string>
  <!-- Menu option in the recently used header\'s menu that forgets every recently used sticker. Verb phrase, imperative. -->
  <string name="MediaKeyboard__clear_recents">Clear recents</string>

  <!-- Gif page -->
  <!-- Label of the GIF quick search chip that shows the GIFs trending right now. -->
  <string name="MediaKeyboard__trending">កំពុងពេញនិយម</string>
  <!-- Label of the GIF quick search chip that searches for celebration GIFs. A search topic, not an instruction to the user. -->
  <string name="MediaKeyboard__celebrate">អបអរសាទរ</string>
  <!-- Label of the GIF quick search chip that searches for GIFs about love. The noun, not the verb. -->
  <string name="MediaKeyboard__love">ស្រឡាញ់</string>
  <!-- Label of the GIF quick search chip that searches for thumbs up GIFs. The hand gesture, as a noun. -->
  <string name="MediaKeyboard__thumbs_up">ចូលចិត្ត</string>
  <!-- Label of the GIF quick search chip that searches for GIFs of someone surprised. Adjective describing the mood in the GIFs. -->
  <string name="MediaKeyboard__surprised">ភ្ញាក់ផ្អើល</string>
  <!-- Label of the GIF quick search chip that searches for GIFs of someone excited. Adjective describing the mood in the GIFs. -->
  <string name="MediaKeyboard__excited">រំភើប</string>
  <!-- Label of the GIF quick search chip that searches for GIFs of someone sad. Adjective describing the mood in the GIFs. -->
  <string name="MediaKeyboard__sad">សោកសៅ</string>
  <!-- Label of the GIF quick search chip that searches for GIFs of someone angry. Adjective describing the mood in the GIFs. -->
  <string name="MediaKeyboard__angry">ខឹង</string>
  <!-- Error message shown in place of the GIF grid when the GIFs could not be fetched. -->
  <string name="MediaKeyboard__couldnt_load_gifs">Couldn\'t load GIFs. Check your connection and try again.</string>
  <!-- Button shown with the GIF loading error that tries the fetch again. Verb, imperative. -->
  <string name="MediaKeyboard__retry">ព្យាយាមម្តងទៀត</string>
</resources>
